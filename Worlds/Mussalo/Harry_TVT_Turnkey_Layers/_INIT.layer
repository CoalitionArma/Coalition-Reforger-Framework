  COA_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "British forces undermine rebel force readiness in town. "\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: Weapons Teams"\
   ""\
   "INDFOR Composition: Infantry"\
   "INDFOR Assets:"\
   ""\
   "Time: 60 Min"\
