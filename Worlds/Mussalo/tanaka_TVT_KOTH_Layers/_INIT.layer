  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "In the war for Mussalo, opposing forces use a beautiful day to attempt to break through the front line. In order to do so, both sides have set their attack on a small village hill overlooking the bay."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "MISSION"\
   "Secure the hill marked on your map at all costs. Once your force dominates the hill, hold it for fifteen minutes."\
   ""\
   "INTENT"\
   "Utilize intelligent infantry platoon tactics to close with and destroy the enemy at or around the hill in any way you see fit."\
   ""\
   "EXECUTION"\
   "Platoon leader discretion"
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
