 coords 0 0 0
 m_bRespawnEnabled 1
 m_bHideOtherSpectatorFactions 1
 m_bWaveRespawn 1
 m_bRallyPointsEnabled 0
 m_iTimeToRespawn 60
 m_iRespawnCutoffMinutes 0
 m_eRespawnMode 0
 m_iTimeLimitMinutes 75
 m_bLockUnusedSlots 1
 m_bUseSafestartTimeLimit 1
 m_iSafestartTimeLimit 10
 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{6B1113DB00007215}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Chernogorsk, half past nine in the morning."\
   ""\
   "A ship is waiting at the end of the harbour breakwater to take the CDF's wounded and the last of the city's medical stores out. The truck carrying them has to come in along the coast road from the west, through the centre of town and down to the docks. The ChDKz hold the streets in between."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1113DB00007216}" {
   m_sTitle "How Payload Works"
   m_sTextData "The truck drives itself. It is orange on your map and it can't be destroyed."\
   ""\
   "It moves while CDF are within 30 m of it and no ChDKz are. More CDF push it faster. You can climb onto it and ride: it carries you with it."\
   ""\
   "One ChDKz within 30 m stops it dead. Left with no CDF near it for 30 seconds, it rolls back, but never past a checkpoint it has already reached."\
   ""\
   "Checkpoints Alpha (the railway crossing), Bravo (the town centre) and Charlie (the harbour gate) each add 5 minutes to the clock, bring back both sides' dead and move both sides' spawns up the road."\
   ""\
   "CDF win when the truck reaches the end of the breakwater. ChDKz win when the clock runs out, unless CDF are still with the truck: then it is overtime, until the truck arrives or they leave it. The result is announced; an admin ends the mission."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1113DB00007217}" {
   m_sTitle "CDF Briefing"
   m_sTextData "MISSION"\
   "Get the truck to the ship at the end of the harbour breakwater."\
   ""\
   "INTENT"\
   "The route is 2.2 km of streets: every window on it is a firing position. The truck only moves with you beside it, so clear the blocks ahead of it before it gets there."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1113DB00007218}" {
   m_sTitle "ChDKz Briefing"
   m_sTextData "MISSION"\
   "Stop the truck reaching the harbour."\
   ""\
   "INTENT"\
   "One of you near the truck stops it, for as long as you live. You own the town: use the buildings along the main streets and make them pay for every block."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 1
 m_iFactionTwoRatio 1
 m_sFactionOneKey "BLU"
