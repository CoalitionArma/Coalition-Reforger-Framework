COA_Gamemode COA_Lobby : "{6A996BBFCEB37E78}Prefabs/Modded Overrides/Coalition Lobby/COA_Lobby.et" {
 components {
  CRF_HostageRescueGamemodeComponent "{6B1127A1D6EFD9E4}" {
   m_sAttackingFaction "BLUFOR"
   m_sDefendingFaction "OPFOR"
   m_sHostageFaction "CIV"
   m_aKeeperCallsigns {
    "AKULA"
   }
   m_bRestrainAtRoundLive 1
   m_eExecutionOutcome BOTH_LOSE
   m_sExtractionName "hostage_extract"
   m_fExtractionRadius 80
   m_fRescueShare 0.6
   m_iTimeLimitMinutes 60
   m_bWipeLoses 1
   m_iIntelFirstMinutes 10
   m_iIntelIntervalMinutes 15
  }
  SCR_TimeAndWeatherHandlerComponent "{64427EEC304DD9A0}" {
   m_bRandomStartingWeather 0
   m_aStartingWeatherAndTime {
    SCR_TimeAndWeatherState "{66EE8AEC3605B974}" {
     m_sWeatherPresetName "Clear"
     m_iStartingHour 1
     m_iStartingMinutes 30
    }
   }
   m_bRandomWeatherChanges 0
  }
 }
 coords 0 0 0
 m_bRespawnEnabled 0
 m_bWaveRespawn 0
 m_bRallyPointsEnabled 0
 m_iTimeToRespawn 60
 m_iRespawnCutoffMinutes 0
 m_eRespawnMode 0
 m_iTimeLimitMinutes 80
 m_bLockUnusedSlots 1
 m_bUseSafestartTimeLimit 1
 m_iSafestartTimeLimit 15
 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{6B1127A1A503377C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Northern Chernarus. 0130, clear."\
   ""\
   "A ChDKz cell holds five hostages in the hills between Gvozdno and Svergovka. A US special operations troop at the Northeast Airfield, 3 km east, launches a night rescue by Black Hawk."\
   ""\
   "BLUFOR: US special operations troop (20), two UH-60. OPFOR: ChDKz cell (40). CIV: hostages (5)."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1127A16616C65F}" {
   m_sTitle "BLUFOR OPORD"
   m_sTextData "1. SITUATION"\
   "a. Enemy: ChDKz cell (40). AK, PK, RPG. No night vision. Holds 5 hostages at an unknown site inside the marked search area (Gvozdno, Zara Quarry, Arsenov, Svergovka). The cell is dispersed across the area."\
   "b. Friendly: SABER troop (20) at the Northeast Airfield, PVS-31 night vision."\
   "- SABER 6: troop commander, MO"\
   "- SABER 1-2: assault teams (6). Team leader, medic, AR, breacher"\
   "- REAPER: sniper, spotter"\
   "- DAGGER 1-2: UH-60 crews (2 pilots each). 11 cabin seats and 2 door M134s per aircraft."\
   ""\
   "2. MISSION"\
   "SABER rescues the hostages and returns them to the airfield NLT 60 min after the round goes live."\
   ""\
   "3. EXECUTION"\
   "a. Intent: find the site, assault it, free the hostages and fly them out. Commander's discretion."\
   "b. Victory: 60% of the hostages rescued (3 of 5). A living hostage inside the extraction point (80 m, airfield apron) is rescued."\
   "c. Defeat (any one): the 60 min clock expires; 3 hostages die; the troop is wiped out."\
   "d. Mutual failure: if the enemy executes a hostage, both sides lose."\
   "e. The first result is final and announced. Play continues until an admin ends the mission."\
   "f. Coordinating instructions:"\
   "- Hostage events (freed, down, rescued, killed) and intel appear as hints."\
   "- Hostages are tied up. Free them with the ACE release action, or escort them."\
   "- A hostage you kill is lost."\
   "- Intel: the hostages' 1 km grid square at +10 min, then every 15 min."\
   ""\
   "4. SERVICE SUPPORT"\
   "No respawns. 2x UH-60 (armed) at the airfield, no respawn."\
   ""\
   "5. COMMAND AND SIGNAL"\
   "Radios for every man. BFT on."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1127A1FC834033}" {
   m_sTitle "OPFOR OPORD"
   m_sTextData "1. SITUATION"\
   "a. Enemy: US special operations troop (20), night vision, two UH-60 with door guns. Based at the Northeast Airfield, 3 km east."\
   "b. Friendly: ChDKz cell (40), in the Zara quarry yard with the hostages."\
   "- AKULA: commander, medic, 2 guards. Holds the hostages."\
   "- VOLK 1-4: rifle squads (8). PK, RPG, rifle grenadier"\
   "- VOLK PK: 2x PK team (4)"\
   "c. Hostages: 5 player civilians, tied up when the round goes live."\
   ""\
   "2. MISSION"\
   "Hold the hostages for 60 minutes."\
   ""\
   "3. EXECUTION"\
   "a. Intent: hide the hostages, defend the site and screen the approaches. The enemy will come by air."\
   "b. Site selection (safe start): leaders open the map, right-click inside the red zone, Forward Deploy Element. The AKULA leader's deploy takes the hostages along. Each VOLK squad deploys on its own."\
   "c. Victory (any one): the 60 min clock expires; 3 hostages die by enemy fire; the troop is wiped out."\
   "d. Defeat: 60% of the hostages (3 of 5) reach the airfield."\
   "e. Mutual failure: if you execute a hostage, both sides lose."\
   "f. The first result is final and announced. Play continues until an admin ends the mission."\
   "g. Coordinating instructions:"\
   "- Hostage events (moved, restrained, recaptured, down, rescued, killed) appear as hints."\
   "- You may re-tie and move hostages (ACE Captives)."\
   ""\
   "4. SERVICE SUPPORT"\
   "No respawns. No vehicles."\
   ""\
   "5. COMMAND AND SIGNAL"\
   "Radios: leaders."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1127A15D4DF09A}" {
   m_sTitle "HOSTAGE BRIEFING"
   m_sTextData "1. SITUATION"\
   "You are one of 5 hostages held by a ChDKz cell. A US rescue force is coming by helicopter."\
   ""\
   "2. MISSION"\
   "Survive and get out."\
   ""\
   "3. EXECUTION"\
   "- Your captors choose where you are held: during safe start you move with them."\
   "- You are tied up when the round goes live. You cannot free yourself."\
   "- Once freed, follow the rescuers. You are rescued when you reach the airfield extraction point (marked)."\
   "- Do not pick up weapons. Do not run before you are freed."\
   "- You may talk to anyone in direct speech. You have no radio."\
   ""\
   "4. SERVICE SUPPORT"\
   "No respawns. Rescued hostages leave the round alive."
   m_aFactionKeys {
    "CIV"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1127A10A6C267B}" {
   m_sTitle "Administration"
   m_sTextData "No respawns. Safe start up to 15 min. The 60 min clock starts when the round goes live. The mode never ends the round: the first result is announced and logged to admins, and an admin ends the mission. Hostage events show as hints."\
   ""\
   "Hostage ROE (admin enforced): hostages stay unarmed and don't run before they are freed."\
   ""\
   "Mission by tanaKa-."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "CIV"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 1
 m_iFactionTwoRatio 2
 m_sFactionOneKey "BLU"
 m_sFactionTwoKey "OPF"
