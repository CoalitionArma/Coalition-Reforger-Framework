COA_Gamemode COA_Lobby : "{6A996BBFCEB37E78}Prefabs/Modded Overrides/Coalition Lobby/COA_Lobby.et" {
 components {
  CRF_TheTurnGamemodeComponent "{7C1AE7B8C9D0E211}" {
   m_sFactionOneKey "BLUFOR"
   m_sFactionTwoKey "OPFOR"
   m_fOutbreakMinutes 25
   m_bDefaultChatter 1
   m_aMessages {
    CRF_TheTurnMessage "{7C1AE7B8C9D0E212}" {
     m_fMinute 6
     m_sFactionKey "OPFOR"
     m_sTitle "Radio: Kabanino"
     m_sText "Our men in Kabanino have stopped answering. Somebody is still keying their radio - all we hear is breathing."
    }
    CRF_TheTurnMessage "{7C1AE7B8C9D0E213}" {
     m_fMinute 8
     m_sFactionKey "BLUFOR"
     m_sTitle "Radio: Battalion"
     m_sText "Battalion: medevac is suspended. The field hospital in Guglovo is not responding. Hold your casualties where you are."
    }
    CRF_TheTurnMessage "{7C1AE7B8C9D0E214}" {
     m_fMinute 20
     m_sFactionKey ""
     m_sTitle "Screams in the treeline"
     m_sText "Something is moving in the woods around the towns. It isn't the enemy."
    }
   }
   m_aSpawnPointNames {
    "turn_zombies_01" "turn_zombies_02" "turn_zombies_03" "turn_zombies_04" "turn_zombies_05" "turn_zombies_06" "turn_zombies_07" "turn_zombies_08" "turn_zombies_09" "turn_zombies_10" "turn_zombies_11" "turn_zombies_12"
   }
   m_iLateWave 4
   m_fWaveSeconds 90
   m_iFirstWaveGroups 2
   m_fGroupsAddedPerWave 1
   m_iMaxGroupsPerWave 8
   m_iMaxZombies 90
   m_fMinSpawnDistance 200
   m_fMaxSpawnDistance 900
   m_fRetargetSeconds 30
   m_fDespawnDistance 1500
   m_fExtractionCallMinutes 15
   m_sLandingZoneName "turn_lz"
   m_iInboundSeconds 240
   m_iBoardingSeconds 120
   m_iSeats 12
   m_fBoardingRadius 15
   m_bEndMissionOnVictory 1
  }
  SCR_TimeAndWeatherHandlerComponent "{64427EEC304DD9A0}" {
   m_bRandomStartingWeather 0
   m_aStartingWeatherAndTime {
    SCR_TimeAndWeatherState "{66EE8AEC3605B974}" {
