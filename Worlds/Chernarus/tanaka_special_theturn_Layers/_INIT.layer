 m_iSafestartTimeLimit 0
 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{7C1AE7B8C9D0E215}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Chernarus, the 31st of October, dusk."\
   ""\
   "The ChDKz have dug into Stary Sobor. The CDF took Novy Sobor back this afternoon, one kilometer to the east, and are pushing west tonight."\
   ""\
   "Both sides have been ignoring the reports coming down from the north: riots in the villages, patrols that stopped answering. Tonight they stop being reports."\
   ""\
   "The civilians are gone. Their cars and vans are still parked around both towns, most of them with barely a drop in the tank."\
   ""\
   "Whatever they left behind is still out there too: weapon stores and supply caches, marked on your map with question marks. Nobody knows what is in which."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{7C1AE7B8C9D0E216}" {
   m_sTitle "CDF Briefing"
   m_sTextData "MISSION"\
   "Clear Stary Sobor of the ChDKz."\
   ""\
   "INTENT"\
   "Push west from Novy Sobor and take the town before the ChDKz can reinforce it."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AE7B8C9D0E217}" {
   m_sTitle "ChDKz Briefing"
   m_sTextData "MISSION"\
   "Hold Stary Sobor."\
   ""\
   "INTENT"\
   "The CDF are coming from Novy Sobor, one kilometer east. Make them pay for every house."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AE7B8C9D0E218}" {
   m_sTitle "Administration"
   m_sTextData ""
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AE7B8C9D0E219}" {
   m_sTitle "Civilian Briefing"
   m_sTextData "MISSION"\
   "Get out of Sobor alive."\
   ""\
   "INTENT"\
   "There is no seat for you on the soldiers' helicopter. When it is called, a refugee truck comes for civilians: it is marked on your map, it waits until the helicopter leaves, and anyone who reaches it is out."\
   ""\
   "EXECUTION"\
   "You start unarmed. The question marks on your map are weapon stores and supply caches; a weapon store gives civilians a pistol. If you die as a civilian, you spectate."
   m_aFactionKeys {
    "CIV"
   }
   m_bShowForAnyFaction 0
  }
 }
