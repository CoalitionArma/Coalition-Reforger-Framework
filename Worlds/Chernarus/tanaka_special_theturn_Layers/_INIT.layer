 m_aMissionDescriptors {
  COA_MissionDescriptor "{7C1AE7B8C9D0E215}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Chernarus, the 31st of October, dusk."\
   ""\
   "The ChDKz have dug into Stary Sobor. The CDF took Novy Sobor back this afternoon, one kilometre to the east, and are pushing west tonight."\
   ""\
   "Both sides have been ignoring the reports coming down from the north: riots in the villages, patrols that stopped answering. Tonight they stop being reports."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{7C1AE7B8C9D0E216}" {
   m_sTitle "CDF Briefing"
   m_sTextData "MISSION"\
   "Clear Stary Sobor of the ChDKz."\
   ""\
   "INTENT"\
   "Push west from Novy Sobor and take the town before the ChDKz can reinforce it."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AE7B8C9D0E217}" {
   m_sTitle "ChDKz Briefing"
   m_sTextData "MISSION"\
   "Hold Stary Sobor."\
   ""\
   "INTENT"\
   "The CDF are coming from Novy Sobor, one kilometre east. Make them pay for every house."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AE7B8C9D0E218}" {
   m_sTitle "Administration"
   m_sTextData "HALLOWEEN SPECIAL - the fight for Stary Sobor does not decide the winner. Keep an eye on the popups: at some point the mission changes, and they tell you what to do."\
   ""\
   "Respawns: 60-second waves from a pool of 40 tickets per side."\
   ""\
   "When things change, the map shows a landing zone. Whoever gets aboard the helicopter there is out of the round and spectates; the side with more players aboard wins."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 1
