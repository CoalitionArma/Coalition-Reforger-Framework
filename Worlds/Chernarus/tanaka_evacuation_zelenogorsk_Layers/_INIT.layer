COA_Gamemode COA_Lobby : "{6A996BBFCEB37E78}Prefabs/Modded Overrides/Coalition Lobby/COA_Lobby.et" {
 components {
  CRF_EvacuationGamemodeComponent "{6ACE7B0200000030}" {
   m_fSiteRadius 150
   m_iTotalLoads 8
   m_iLoadsToWin 5
