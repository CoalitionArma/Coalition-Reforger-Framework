 coords 0 0 0
 m_bRespawnEnabled 1
 m_bWaveRespawn 1
 m_bRallyPointsEnabled 0
 m_iTimeToRespawn 60
 m_iRespawnCutoffMinutes 0
 m_eRespawnMode 0
 m_iTimeLimitMinutes 120
 m_bLockUnusedSlots 1
 m_bUseSafestartTimeLimit 0
 m_iSafestartTimeLimit 0
 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{6B1108A500000010}" {
   m_sTitle "Mission: Situation"
   m_sTextData "South-East Chernarus. Morning, clear skies."\
   ""\
   "The ChDKz insurgency is being run by a field commander who never sleeps in the same place twice. He rides with a small armed convoy that loops the roads between Elektrozavodsk, the Pusta hills, Polana and the coast, day and night. His headquarters is hidden somewhere in the hills north of Elektrozavodsk."\
   ""\
   "A NATO special operations task unit at the Northwest Airfield has been tasked with taking him off the board and rolling up his headquarters."\
   ""\
   "BLUFOR: six SF teams (VIPER 1-6), each with its own MH-6M Little Bird, and a command element (SABRE 6)."\
   "OPFOR: ChDKz insurgents. The convoy and the HQ garrison are AI; a small player cell (CELL) is based at the HQ."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1108A500000011}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "1. Find and interdict the convoy. Its route is marked on your map; it patrols the loop continuously."\
   "2. Take the officer riding with the convoy. Get close and stop his vehicle and he will surrender - restrain him (zip-ties)."\
   "3. Clear and secure the insurgent HQ."\
   "4. Return to the Northwest Airfield. The mission ends when the HQ is secured and every living member of the task unit is back at base."\
   ""\
   "INTEL"\
   "Take the officer ALIVE: a restrained officer gives up the exact location of the HQ, and it is marked on your map."\
   "If he is killed, the documents on him only point to a rough area (a large circle on your map) - you will have to find the HQ yourselves."\
   "The HQ counts as secured when you hold it with no more than a couple of insurgents left alive inside it for 30 seconds."\
   ""\
   "ASSETS"\
   "Each VIPER team has one MH-6M on its own pad at NWAF. Your team spawns next to it. Lose it and it is gone."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1108A500000012}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Protect the convoy and defend the HQ."\
   ""\
   "SITUATION"\
   "The commander's convoy (a command UAZ, two technicals and a Ural) is patrolling its loop. The Americans want the commander alive - if they catch him, he will give up the HQ."\
   "The HQ is in Pusta and is garrisoned by our fighters. The cell spawns at the HQ and has one technical."\
   ""\
   "YOU WIN if the Americans run out of time (120 minutes), or if they are wiped out with no respawns left."\
   ""\
   "EXECUTION"\
   "Commander's discretion. Escort the convoy, hunt the helicopters, or hold the village - but the HQ must not fall."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1108A500000013}" {
   m_sTitle "Administration"
   m_sTextData "Wave respawn every 60 seconds."\
   "BLUFOR: 60 tickets. Respawns at the NWAF spawn."\
   "OPFOR: 10 tickets. Respawns at the HQ."\
   "Helicopters do not respawn."\
   ""\
   "Time limit: 120 minutes from the end of safe start. When it runs out, OPFOR win."\
   ""\
   "Mission by tanaKa-."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 15
