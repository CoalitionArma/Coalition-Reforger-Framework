 coords 0 0 0
 m_bRespawnEnabled 1
 m_bHideOtherSpectatorFactions 1
 m_bWaveRespawn 1
 m_bRallyPointsEnabled 0
 m_iTimeToRespawn 60
 m_iRespawnCutoffMinutes 0
 m_eRespawnMode 0
 m_iTimeLimitMinutes 75
 m_bLockUnusedSlots 1
 m_bUseSafestartTimeLimit 1
 m_iSafestartTimeLimit 10
 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{5F3A91C27D4E7215}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Chernarus, afternoon."\
   ""\
   "The CDF garrison in Novy Sobor is out of ammunition and fuel. One truck is coming up the road from the south with everything they need. The ChDKz know it, and they know there is only the one road."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{5F3A91C27D4E7216}" {
   m_sTitle "How Payload Works"
   m_sTextData "The truck drives itself. It is orange on your map and it can't be destroyed."\
   ""\
   "It moves while CDF are within 30 m of it and no ChDKz are. More CDF push it faster."\
   ""\
   "One ChDKz within 30 m stops it dead. Left with no CDF near it for 30 seconds, it rolls back down the road, but never past a checkpoint it has already reached."\
   ""\
   "Checkpoints Alpha, Bravo and Charlie each add 5 minutes to the clock, bring back both sides' dead and move both sides' spawns up the road."\
   ""\
   "CDF win when the truck reaches Novy Sobor. ChDKz win when the clock runs out, unless CDF are still with the truck: then it is overtime, until the truck arrives or they leave it."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{5F3A91C27D4E7217}" {
   m_sTitle "CDF Briefing"
   m_sTextData "MISSION"\
   "Get the truck to Novy Sobor."\
   ""\
   "INTENT"\
   "The truck only moves with you beside it, but the people beside it aren't the ones who will clear the road. Send someone ahead."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{5F3A91C27D4E7218}" {
   m_sTitle "ChDKz Briefing"
   m_sTextData "MISSION"\
   "Stop the truck reaching Novy Sobor."\
   ""\
   "INTENT"\
   "One of you near the truck stops it, for as long as you live. Every minute it stands still is a minute off their clock."\
   ""\
   "EXECUTION"\
   "Commander's discretion."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 1
 m_iFactionTwoRatio 1
 m_sFactionOneKey "BLU"
 m_sFactionTwoKey "OPF"
