  COA_MissionDescriptor "{6A33342358273751}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Bundeswehr make first contact with an unknown Russian force composition. Defending PL has 2 minutes from safestart start to decide on 1 of 3 AO's, and then each PL must choose their own force multipliers."\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: Platoon Choice"\
   ""\
   "OPFOR Composition: Infantry"\
   "OPFOR Assets: Platoon Choice"\
   ""\
   "Time: 45 Min"\
   "Weather: Clear Day"
