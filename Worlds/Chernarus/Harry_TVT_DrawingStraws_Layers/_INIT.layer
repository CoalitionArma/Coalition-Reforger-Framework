  }
  COA_MissionDescriptor "{6A33342358272AC5}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Capture the assigned control point, or complete the attrition goal. "\
   ""\
   "INTENT"\
   "This is a freeform mission that will ask more of platoon than normal. Decide on force multipliers, and adjust to the chosen AO. "\
   ""\
   "EXECUTION"\
   "Impossible to say"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A33342358272A1D}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Defend the assigned control point, or complete the attrition goal. "\
   ""\
   "INTENT"\
   "This is a freeform mission that will ask more of platoon than normal. Defending PL or their representative in case of disconnect has 2 minutes to decide the AO, or it will default to 1, and then must decide on force composition. "\
   ""\
   "EXECUTION"\
   "Impossible to say"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A33342358272954}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A3334235827289E}" {
   m_sTitle "Administration"
