   m_fExtraWorkerSpeed 0.5
   m_fWorkRadius 8
   m_bKillerStopsWork 1
   m_bRevealWork 1
   m_sRadioName "slasher_radio"
   m_iRadioSeconds 20
   m_sExtractionName "slasher_lz"
   m_iInboundSeconds 150
   m_iBoardingSeconds 60
   m_fExtractionRadius 20
   m_iSurvivorsToEscape 1
   m_iTimeLimitMinutes 60
   m_bEndMissionOnVictory 0
   m_bKillersTireless 1
   m_fKillerDamageTaken 0.35
   m_fSurvivorMaxSpeed 0.9
   m_fTerrorRadius 30
  }
  SCR_TimeAndWeatherHandlerComponent "{64427EEC304DD9A0}" {
   m_bRandomStartingWeather 0
