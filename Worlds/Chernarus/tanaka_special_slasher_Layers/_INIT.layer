 }
 coords 0 0 0
 m_bRespawnEnabled 1
 m_bWaveRespawn 1
 m_bRallyPointsEnabled 0
 m_iTimeToRespawn 30
 m_iRespawnCutoffMinutes 0
 m_eRespawnMode 0
 m_iTimeLimitMinutes 75
 m_bLockUnusedSlots 1
 m_bUseSafestartTimeLimit 0
 m_iSafestartTimeLimit 0
 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{7C1AF1A2B3C4D612}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Grishino, the 31st of October, 2300."\
   ""\
   "The harvest festival was still going when the power died. The phone lines are dead and the people who went to look at the generators haven't come back."\
   ""\
   "Something is out there in the fog. It wears a mask."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{7C1AF1A2B3C4D613}" {
   m_sTitle "SURVIVORS Briefing"
   m_sTextData "MISSION"\
   "Get out of Grishino alive."\
   ""\
   "HOW"\
   "- Generators: get all four running. Stand at one to work on it (two and a half minutes alone, quicker with two or three of you). Your map shows each generator and how far along it is."\
   "- They hear it: when you start on a generator, they're told roughly where it is. If one of them is next to it, the work stops."\
   "- Radio: once all four generators run, the radio in the farm yard has power. Hold it for 20 seconds to call for extraction."\
   "- Extraction: it lands at the airfield helipad, a kilometre west, two and a half minutes after the call, and waits one minute. Be there."\
   ""\
   "WHAT YOU'RE UP AGAINST"\
   "- They never tire and they're hard to put down. You're slower than them and you only have a pistol and two magazines."\
   "- \"Something is close\" means one of them is within 30 metres."\
   "- Listen: they murmur while they move and scream when they run. When it goes quiet, they're standing still - and could be anywhere."\
   "- Flashlights help you see, and help them see you."\
   ""\
   "If even one of you gets out, you win."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AF1A2B3C4D614}" {
   m_sTitle "KILLERS Briefing"
   m_sTextData "MISSION"\
   "Nobody leaves Grishino."\
   ""\
   "HOW"\
   "- Your blade: switch to your sidearm slot and use the melee key to strike."\
   "- You never tire, you take a third of the damage they do, and your mask has night vision - switch it on."\
   "- When they start on a generator you're told where. Standing next to one stops their work."\
   "- When the radio has power you're told where it is; when they call extraction you're told where it lands."\
   "- You respawn in 30-second waves at your camp in the woods north of the village."\
   "- They can hear you: you murmur while you move and scream when you sprint. Stand still and you make no sound - wait for them."\
   ""\
   "You win if nobody escapes: they all die, the extraction leaves without them, or an hour passes."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AF1A2B3C4D615}" {
   m_sTitle "Administration"
   m_sTextData "Survivors don't respawn. Killers respawn in 30-second waves."\
   ""\
   "Slot four KILLERS (Rifleman slots only - the blade is set on that role)."\
   ""\
   "A dead killer's body vanishes after five seconds, mask and blade included."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 8
