COA_Gamemode COA_Lobby : "{6A996BBFCEB37E78}Prefabs/Modded Overrides/Coalition Lobby/COA_Lobby.et" {
 components {
  CRF_SlasherGamemodeComponent "{7C1AF1A2B3C4D611}" {
   m_sSurvivorFaction "BLUFOR"
   m_sKillerFaction "OPFOR"
   m_aGeneratorNames {
    "slasher_generator_1" "slasher_generator_2" "slasher_generator_3" "slasher_generator_4"
   }
