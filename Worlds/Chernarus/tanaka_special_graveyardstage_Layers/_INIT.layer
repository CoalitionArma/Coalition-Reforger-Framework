 m_aMissionDescriptors {
  COA_MissionDescriptor "{7C1AE9A00000003C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Chernarus, the 31st of October. Half past eleven at night, rain, and a fog you can barely see the bonnet through."\
   ""\
   "Somebody thought it would be funny to run the Halloween stage through the dead village. The road leaves Stary Sobor, climbs into the woods, passes the graveyard and the ruined church, then drops a hundred and fifty metres through the forest to the finish on the valley road."\
   ""\
   "Nobody lives in the village any more. Nobody remembers why."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{7C1AE9A00000003D}" {
   m_sTitle "Crew Briefing"
   m_sTextData "MISSION"\
   "Set the fastest stage time, start to finish."\
   ""\
   "EXECUTION"\
   "Crews of two: a driver and a co-driver. You spawn in your crew's car on the main road east of the start, driver at the wheel. The car is held where it is, handbrake locked, until your start time. At GO drive to the start line: your stage clock starts when you cross it, so a place further back on the grid costs you nothing - but you only get 30 seconds to get there. Crews leave one at a time, 30 seconds apart, in group order - BANSHEE first, at the front of the grid; the HUD counts you down."\
   ""\
   "DRIVER: the pace notes come up on your screen as you reach each corner, and the full roadbook is in the next briefing tab."\
   ""\
   "CO-DRIVER: every pace note is on your map, numbered, as an orange dot at its corner, along with the checkpoints. Keep the map open, read the next corners out early, and keep the driver on the road when the fog closes in."\
   ""\
   "Every checkpoint has to be crossed in order. Jumping your start costs 10 seconds."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AE9A00000003E}" {
   m_sTitle "Roadbook"
   m_sTextData "Graveyard Stage - 4.79 km, point to point, dirt with two short asphalt sections."\
   ""\
   "Grades: 1 is the tightest corner, 6 the fastest. Square: a 90 degree junction. Distances in metres to the next call; into and and mean it follows straight on."\
   ""\
   "0.03 km   Stage start. Left 4 opens, 150"\
   "0.23 km   At junction left 2, 400"\
   "0.60 km   Steep downhill, 200"\
   "0.80 km   Left 4, 80"\
   "0.98 km   At junction square right onto asphalt, and steep downhill, into at junction hairpin left onto dirt"\
   "1.22 km   Hairpin right, and left 4 tightens, 200"\
   "1.45 km   Steep downhill, 250"\
   "1.70 km   Caution, at junction square left, into dip, and at junction square right"\
   "2.00 km   Left 4 opens, 400"\
   "2.40 km   Caution, left 2, 100"\
   "2.61 km   Hairpin right, into left 4 long opens, 200"\
   "3.02 km   Graveyard right, into ruined church right, 80"\
   "3.14 km   Onto asphalt, 150"\
   "3.23 km   Caution, at junction hairpin right onto dirt, into steep downhill, 50"\
   "3.40 km   Square left, and right 3, into left 3"\
   "3.59 km   Dip, into right 3 long opens, into crest"\
   "3.66 km   Steep downhill, 300"\
   "3.90 km   Steep downhill, and right 5, 80"\
   "4.11 km   Right 2, into left 3, and right 1"\
   "4.34 km   Hairpin left"\
   "4.64 km   Flying finish, 150"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1AE9A00000003F}" {
   m_sTitle "Administration"
   m_sTextData "HALLOWEEN SPECIAL - rally stage. No respawns: a crashed crew is out. Night, rain and heavy fog all stage long; turn your headlights on."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
