 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{7C1A9B0C1D2E3F11}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Halloween night, 2300. Something is spreading through Chernarus and the northwest airfield is the last way out."\
   ""\
   "The garrison's Huey and Ural at the south-east end of the airfield were stripped for parts and drained of fuel. Fix one up and get out before it reaches you - but the infection is already inside the garrison."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{7C1A9B0C1D2E3F12}" {
   m_sTitle "SURVIVORS Briefing"
   m_sTextData "MISSION"\
   "Repair and refuel the Huey or the Ural at the south-east end of the airfield, get aboard, and get 2 km away."\
   ""\
   "HOW"\
   "- Both start with empty tanks and wrecked engines (the Huey's rotors are damaged too)."\
   "- Fuel: jerrycans are around the airfield. Each vehicle needs 60 litres (three jerrycans)."\
   "- Repairs: repair kits are around the airfield. Repair the engine (and the Huey's rotors) to at least 45%."\
   "- You'll be told when a vehicle is fuelled, repaired and ready."\
   ""\
   "THE INFECTION"\
   "- A few of you are already infected and don't show it. They know who they are. You don't."\
   "- A hit from the infected can infect you. If you're bitten you'll be told, and you have a few minutes to find an antidote before you turn."\
   "- Antidote crates (medical boxes) hold four doses between them. A dose only cures a bite."\
   "- Anyone who dies rises as one of them."\
   ""\
   "Whoever is aboard when the vehicle gets away escapes. If only the infected are aboard - or every vehicle is destroyed, or nobody is left - the infection wins."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1A9B0C1D2E3F13}" {
   m_sTitle "INFECTED Briefing"
   m_sTextData "MISSION"\
   "Stop anyone leaving. Every survivor you bring down joins you."\
   ""\
   "HOW"\
   "- Claws only: switch to your sidearm slot and use the melee key to strike. A hit can infect a survivor."\
   "- You never tire: sprint as long as you like. You travel light, so you're quicker than a loaded survivor."\
   "- A 6B3 vest takes some of their fire, and two smoke grenades cover your approach."\
   "- You see in the dark: switch on the night vision on your mask."\
   "- Your body crumbles away a few seconds after you die."\
   "- You respawn in waves from the hills west of the airfield."\
   "- The survivors are trying to fix the Huey and the Ural at the south-east end of the airfield. Get there first and keep them away from it."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{7C1A9B0C1D2E3F14}" {
   m_sTitle "Administration"
   m_sTextData "Survivors don't respawn: dead survivors rise as infected after 10 seconds. The infected respawn in 30-second waves."\
   ""\
   "Only slot GHOULS on the infected side. The TURNED groups are filled automatically when survivors turn - don't slot them."\
   ""\
   "Hidden carriers: one in ten survivors, picked two minutes after safestart. They turn after 15-25 minutes."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 7
 m_iFactionTwoRatio 1
 m_sFactionOneKey "BLU"
 m_sFactionTwoKey "OPF"
