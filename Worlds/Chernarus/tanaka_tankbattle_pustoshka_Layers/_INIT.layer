 m_iSafestartTimeLimit 0
 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{6B1118C34A8B9556}" {
   m_sTitle "Mission: Pustoshka Fields"
   m_sTextData "The fields south-east of Pustoshka, midday. Forty armoured vehicles a side."\
   ""\
   "You spawn on foot at your flag and a menu asks you to pick a vehicle. It appears with you in the driver's seat, and the main gun answers to you too."\
   ""\
   "VEHICLES (both sides)"\
   "Tanks: M1A1 Abrams (3 per side), T-14 Armata (2), T-90M (2), T-72A (3), T-72B (3), Stryker MGS 105 mm (2)."\
   "IFVs: Kurganets-25 (57 mm), LAV-25 (25 mm)."\
   "APCs and scouts: Kurganets-25 RWS (12.7 mm), BTR-70 (14.5 mm), BRDM-2 (14.5 mm)."\
   "Artillery: 2S1 Gvozdika, 122 mm (1)."\
   "A full type is greyed out in the menu until one of your side's is destroyed."\
   ""\
   "CONTROLS"\
   "W / A / S / D: drive, as in any vehicle. The engine starts by itself when the round goes live."\
   "Mouse: aim the main gun. Left click: fire. Right click: the gun sight."\
   "The camera stays in third person, and you can't get out."\
   ""\
   "POINTS"\
   "BLUFOR starts at the west end of the field, OPFOR at the east end. Three points lie across the field between you: A to the north, B in the middle, C to the south - each the same distance from both sides (marked on the map, the minimap and the bar at the top of the screen)."\
   "A tank alone in a point captures it in 20 seconds; more tanks capture faster; tanks from both sides stop it. An enemy point is neutralised first, then captured."\
   ""\
   "WINNING"\
   "Each point your side holds fills your bar by 2 a second, and all three add 4 more. Each kill is worth 10. The first side to 1000 wins."\
   ""\
   "REPAIRS"\
   "A destroyed engine or gearbox leaves you stuck but not dead. The IFVs, APCs and the BRDM-2 (Kurganets-25, LAV-25, Kurganets-25 RWS, BTR-70, BRDM-2) can fix it: stop within 15 m of the stuck vehicle, both of you stopped, and it's repaired in 15 seconds. Stuck vehicles show amber on the minimap."\
   ""\
   "RESPAWN"\
   "When your vehicle is destroyed, so are you. 10 seconds later you're back at your flag to pick another."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1118C30A6C267B}" {
   m_sTitle "Administration"
   m_sTextData "The mode respawns players itself (10 s); the mission's own respawn is off."\
   "Vehicles are held (engine off, handbrake on) until safe start ends."\
   "The sides must be even (1:1). The mode warns everyone at round start if they aren't; use the slot balancer."\
   "The first full bar wins: the winner is announced and the tanks are held, but the mission doesn't end by itself. Run the AAR when you're ready (or it ends at the 40-minute time limit)."\
   ""\
   "Mission by tanaKa-."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 1
 m_iFactionTwoRatio 1
 m_sFactionOneKey "BLU"
 m_sFactionTwoKey "OPF"
