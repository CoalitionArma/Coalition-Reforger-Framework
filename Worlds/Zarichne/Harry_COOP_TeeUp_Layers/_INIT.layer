  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Blufor wants to push across the river, and establish a foothold on the other side. A team is being deployed to weaken the enemy's defenses before the attack begins in full. "\
