 m_aMissionDescriptors {
  COA_MissionDescriptor "{69F945A07E8B135A}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Islamic revolutionaries strike against Somali locals organized in Mogadishu hoping to degrade their capabilities. "\
   ""\
   "BLUFOR Composition: Inf"\
   "BLUFOR Assets: 1xBRDM, Ammunition truck, satchels"\
   ""\
   "OPFOR Composition: Inf"\
   "OPFOR Assets: Mat team, satchels"\
   ""\
   "Time: 50"\
   "Weather: Day Cloudy"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{69F945A07E8B1695}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Either do 2 of 3: remove the HAT threat from the central MSR, destroy the enemy supply cache, destroy the enemy fuel containers"\
   " OR "\
   "Attrite the enemy by 90%. "\
   ""\
   "INTENT"\
   "Blufor can choose where and when to engage, and properly prepare the battlefield. Satchels, and leave behind forces will be your biggest challenge. "\
   ""\
   "EXECUTION"\
   "Choose the areas that you are going to fight in, prepare sufficient cordon to control the space that you want to fight in, and get your breaching teams small. "
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69F945A07E8B1585}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Keep the HAT threatening the main MSR into Mog, defend the supply warehouse, and defend your fuel depot. "\
   "OR "\
   "Destroy 66% of the enemy force"\
   ""\
   "INTENT"\
   "You have more territory than you can realistically control with your limited troops, and you will lose in a traditional confrontation. Figure out how to bleed the enemy before they can accomplish their objectives."\
   ""\
   "EXECUTION"\
   "Commanders discretion"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69F945A07E8B14CD}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69F945A07E8B142B}" {
   m_sTitle "HAT Objective"
   m_sTextData "The HAT objective begins positioned at the marked radio tower, and has one round it can use. The round may be spent, and isn't needed to threaten the MSR. Defenders may disassemble, but may not move the emplacement until after safestart has ended. Then, defenders may move the emplacement as they feel necessary. "\
   ""\
   "There will be an 8 minute grace period for this objective. After which, while the HAT emplacement is not protecting the main road into the city by being clearly visible from it, it will count as an attacker completed objective. "
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6A0D13D215302C1D}" {
   m_sTitle "Ladders"
   m_sTextData "Both sides TLs have been given ladders. These can be used to navigate the city more easily, or serve as a mobile platform for your AR. Do not wedge yourself into an unrealistic position using them, or moderators/admins will intervene. "
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 2
