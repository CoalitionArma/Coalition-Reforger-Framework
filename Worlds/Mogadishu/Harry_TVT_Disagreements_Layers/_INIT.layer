 m_aMissionDescriptors {
  COA_MissionDescriptor "{69DCFAADF0A2F6A9}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Islamic revolutionary forces have brought jihad to Somalia. Locals fight for control over the outskirts of Mogadishu."\
   ""\
   "BLUFOR Composition: Moto inf"\
   "BLUFOR Assets: Battle bus, gun trucks"\
   ""\
   "OPFOR Composition: Moto inf"\
   "OPFOR Assets: Suicide team, gun trucks, embedded mmg"\
   ""\
   "Time: 60 min"\
   "Weather: Day Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{69DCFAADF0A2EA61}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Fight for the frontline objectives while preserving your force. Refer to the win conditions page for winner scoring. Vehicles will not respawn."\
   ""\
   "INTENT"\
   "The two forces are asymetrically arrayed. Weigh the benefits, and challenges of having smaller teams, with a larger, slower battle bus. One side isn't inherently \"stronger\", it will come down to use. "\
   ""\
   "EXECUTION"\
   "If you can protect the battle bus, it should be strong fire support."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69DCFAADF0A2E97F}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Fight for the frontline objectives while preserving your force. Refer to the win conditions page for winner scoring. Vehicles will not respawn."\
   ""\
   "INTENT"\
   "The two forces are asymetrically arrayed. Weigh the benefits, and challenges of having larger teams, with more short range explosives."\
   ""\
   "EXECUTION"\
   "Plan for how to mitigate the enemies improved long range fire power."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69DCFAADF0A2E80D}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69DCFAADF0A2EFBA}" {
   m_sTitle "Win Conditions"
   m_sTextData "If one team captures and holds all three frontline objectives, they will win. "\
   ""\
   "If one team completes attrition by reducing the enemy force by 80% they will win. Attrition will reset whenever a respawn wave occurs from an objective changing control."\
   ""\
   "If neither are completed within the time limit, the winner will be scored on attrition percent with the B zone counting as 15% to whoever controls it."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{69FB3457781E7DEA}" {
   m_sTitle "VBIED Truck"
   m_sTextData "The truck filled with barrels is the new VBIED. It needs an external explosive method to set it off. "
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
