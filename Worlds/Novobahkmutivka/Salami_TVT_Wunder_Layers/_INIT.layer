 m_aMissionDescriptors {
  COA_MissionDescriptor "{6AAE2A8F7DBB880C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "It is July 12th, 1943, the German offensive around Kursk has failed. The Soviets have begun their counteroffensive, on the exposed flank is an undermanned and battered German Company defending the Regiments flank. A Soviet rifle company seeks to exploit this weakness to drive Soviet armor into the flank of the Germans."\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets:"\
   ""\
   "OPFOR Composition: Infantry"\
   "OPFOR Assets:"\
   ""\
   "Time: Mid-Day"\
   ""\
   "Weather: Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6AAE2A8F7DBB8458}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "- Defend MCOM A"\
   "- Defend MCOM B"\
   "- Defend MCOM C"\
   ""\
   "INTENT"\
   "MCOM A is inside of a destroyed factory building, try not to rat in the rubble so hard and focus on the actual defense of the building itself. "\
   ""\
   "MCOM B is a trench network which you will have to run up on or retreat to after MCOM A is taken as you will not spawn up there."\
   ""\
   "MCOM C is your spawn and is more or less the same as MCOM A but not as blown out. "\
   ""\
   "EXECUTION"\
   "Commanders discretion"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AAE2A8F7DBB849D}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "- Capture MCOM A"\
   "- Capture MCOM B"\
   "- Capture MCOM C"\
   ""\
   "INTENT"\
   "Utilize the micro terrain of the map to close the distance, you have been given a lot of DP28s to offset the German MG42 but you will almost always just have to find gaps in their defensive posture and exploit that."\
   ""\
   "EXECUTION"\
   "Commanders Discretion"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AAE2A8F7DBB8523}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AAE2A8F7DBB8274}" {
   m_sTitle "Administration"
   m_sTextData "Place any meta or technical information that players should know here. Otherwise, leave empty."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
