 coords 3419.49 374.195 2716.154
 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTextData "Blufor has a valuable civilian asset, and are trying to arrange for extract for them. Opfor needs to capture the civilian asset alive, and get them back to their base. In the event of HVT death, Whoever is most responsible will lose. Blufor should protect them from harm, and Opfor should consider their ROE."\
   ""\
   "BLUFOR Composition:  Infantry"\
   "BLUFOR Assets: Mortars, Constructable Defenses"\
   ""\
   "OPFOR Composition: Moto Inf"\
   "OPFOR Assets: BRDM, Mortars"\
   ""\
   "Time: 45 min"\
   "Weather: Rainy"
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTextData "Protect the HVT at all costs."
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTextData "Get the HVT back to your base."
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "Civilian Objectives"
   m_sTextData "Play a fun civilian. You were picked up by Blufor because you are valuable somehow. They want to protect you, and you must value your life. Do everything you can to stay alive. Do not run off on your own. You must comply with all instructions given by an armed person. "\
   ""\
   "IMPORTANT: Pick up the intelligence folder in front of you when you spawn. This holds the transponder used to track you. Under no circumstances remove it. "
   m_aFactionKeys {
    "CIV"
   }
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTextData "Blufor has been given an engineering truck with supplies next to it. You will need to put supplies into your truck. You can access the building menu from the back of the truck."\
   ""\
   "Both sides have trucks filled with mortars, and backpacks that assemble into mortar tubes. Consider deployement location, and munitions staging. "\
   ""\
   "The HVT will have a transponder on them they cannot remove."
  }
 }
