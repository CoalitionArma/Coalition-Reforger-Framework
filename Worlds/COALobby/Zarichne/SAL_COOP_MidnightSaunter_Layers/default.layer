 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTextData "A German unit has been haulted in it's tracks along the Zarichne river, we've been tasked in to destroy some artillery that's been bombarding our German friends. These 2S1s are slippery and don't stay in one area for too long after firing. Find them and take them out. "\
   ""\
   "Once you are sastified we must capture the western side of the bridge across the Zarichne river. The Germans have attempted numerous infiltration and breakthroughs that have failed because of the positions across the river. We must capture these positions for the German breakthrough in the morning."\
   ""\
   "BLUFOR Composition: Armored/Infantry/Mechanized/Etc.."\
   "BLUFOR Assets:"\
   "JTAC"\
   ""\
   "Time: 90"\
   ""\
   "Weather: Clear"
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTextData "- Destroy the 2 2S1 positions first"\
   "- Capture the bridge"
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTextData "To call in CAS the JTAC must pull out his binos and use the RHS radial menu."\
   ""\
   "Anyone with a DAGR can call in CAS."\
   ""\
   "Respawns: Once an objective is captured it triggers a respawn wave."
  }
 }
