 m_iTimeLimitMinutes 80
 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTextData "Insurgent activity has led to the complete takeover of the town of Zarichne. All civilians have been ordered to evacuate. Now D Coy, 40 Commando of the Royal Marines is preparing for a raid on the town to knock out explosive caches used to spread a reign of terror across the region."\
   ""\
   "BLUFOR Composition: Infantry Company"\
   "BLUFOR Assets:"\
   "1x Weapons Platoon"\
   "2x Land Rover Gun Truck"\
   "1x Alouette Scout Helicopter (GPMG)"\
   ""\
   "OPFOR Composition: Guerilla Infantry"\
   "OPFOR Assets:"\
   "3x Bombsetters"\
   ""\
   "Time: 0230 hours (Dawn)"\
   ""\
   "Weather: Clear Light Fog"
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTextData "Move in to destroy the two caches marked in the city blocks on the map. To win, both caches must be destroyed."\
   "The more time given to the enemy, including during safestart, the more organized and well armed they will be when you arrive."
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTextData "-Check the building you spawn in or in front of, all levels of it, to see if it is a cache."\
   "- If so find other teammates and spread the word about the location. If not, move out into the town and link up with other teammates until you locate a cache."\
   "- Arm yourself at the cache, leaving gear and weapons for your teammates. DO NOT take two primary weapons excluding a launcher."\
   "- Organize yourself at the cache and move out."\
   "- If a leader, medic, or bombsetter, move out to your respective building marked on your map to acquire further equipment. DO NOT go to these buildings for equipment if it is not your role."\
   ""\
   "- Defend the two caches inside the town. Attackers must destroy both to win."
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTextData "What the caches look like is visible in the AAR entry for the mission. They are only destructible by C4 blocks or more capable explosives. Hand grenades are not able to destroy the cache. It will have a massive secondary explosion."
  }
 }
 m_iFactionOneRatio 2
 m_sFactionOneKey "BLU"
 m_sFactionTwoKey "IND"
