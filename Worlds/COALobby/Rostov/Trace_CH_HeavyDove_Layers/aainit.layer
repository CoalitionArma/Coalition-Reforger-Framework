   ""\
   "Weather:"\
   "Clear"
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTextData "Our Company has been largely wiped out, and we're the only ones left. Defend our ammunition caches until reinforcements can arrive."
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTextData "ISR located a platoon sized element of US Marines operating within a small village in Rostov Oblast. Find and eliminate them and any supplies they may have amassed."
  }
