 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "A ZFR C-130 transport crew has been shot down in splintered ZWC territory. ZFR QRF has been activated, but on such short notice, only can afford who is immediately available. "\
   ""\
   "ZWC has scrambed a large search party with the intent to capture the crew for information."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Recover the downed crew and extract them to the marked extraction zone. Once there, hold for 10 minutes for extract."\
   ""\
   "INTENT"\
   "Utilize your technological advantage to identify where the crashed INDFOR C-130 crew is. Once done, COY should orchestrate a recovery effort with land-based vehicles ONLY. Extract to the marked area and hold for 10 minutes."\
   ""\
   "You may use the provided Mi-8 to assist with searching as well as covering the downed crew, but you may not extract/move them with it."\
   ""\
   "The C-130 crew has green flares and will use them to attempt to communicate."\
   ""\
   "EXECUTION"\
   "Commander discretion due to highly changing environment."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Recover the downed crew and extract them to the marked extraction zone. Once there, hold for 10 minutes to capture them."\
   ""\
   "INTENT"\
   "Use your drone to identify the downed crew. Once done, utilize your overwhelming numbers advantage to identify where the downed C-130 crew is and recover them. "\
   ""\
   "You may use as many vehicles as you want for light sources and transport. Use your flashlights. They are your only way of seeing in the dark and double as a friendly indicator to others."\
   ""\
   "EXECUTION"\
   "Commander discretion due to highly changing environment."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Survive"\
   ""\
   "INTENT"\
   "Use SERE tactics to avoid OPFOR forces and link up with allied BLUFOR forces. If captured, comply with your captors demands."\
   ""\
   "You may choose to split up or stay together. Regardless of outcome, you will be escorted to one of multiple extract points. If you believe your life to be in danger, you may attempt to resist as you see fit."\
   ""\
   "You may use the green flares in your inventory to communicate with your rescuers."\
   ""\
   "EXECUTION"\
   "Commander discretion due to highly changing environment."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "N/A"
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
 }
