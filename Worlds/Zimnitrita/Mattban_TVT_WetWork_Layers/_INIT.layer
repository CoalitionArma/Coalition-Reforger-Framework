  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "(INFOR) ATTACKING: A proxy funded zimnitritan hardliner group aims to infiltrate and break out imprisoned POWS from the Zimnitrita liberation war that are rotting away on Samotnist Island compound."\
