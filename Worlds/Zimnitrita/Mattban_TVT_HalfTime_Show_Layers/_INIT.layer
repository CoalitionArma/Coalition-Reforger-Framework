 m_aMissionDescriptors {
  COA_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "lore: "\
   "A rouge PMC group have captured and are occupying the city of Andruhanov on the big game day. While US forces move in to intercept. Looks like we're going to have a impromptu too Home vs Away game. "\
   ""\
   "Mission Rules:"\
   "All US players please slot blufor"\
   "All non- US players please slot indfor. "\
   "if we still have to fill a side for ratio that's more importuned.   "\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: 2x  Armed UH1Hs"\
   ""\
   "INDFOR Composition: Armored/Infantry"\
   "OPFOR Assets: 2x BTR70s"\
   ""\
   "Time: 04:00:00"\
   "Weather: heavy fog"\
   ""
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "USA. USA. USA. *Eagle Screech*"\
   "The city of Andruhanov was hosting a big international f-\"Soccer\" game and your in the finals where you and the guys were going to play and support, But those damn terrorists put a bomb on the pitch. Luckily you all packed your military gear for this very occasion. Get rid of those damn bombs and try to keep 11 ALIVE for a game after tho they might be traumatised, "
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "If OPFOR is playable, add mission objectives in bullet point list. Add details for each if you feel necessary, but keep it concise."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "Those damn USA fun police are on there way to the International \"Football\" game hosted this year in Andruhanov. and they might win... "\
   "So we cant have that, So repel them or kill them. But buy enough time for the bombs to go off and destroy the pitch and the building the comity organisers are staying boarded up in."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData ""
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
 }
