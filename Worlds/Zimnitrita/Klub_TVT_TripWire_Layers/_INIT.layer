 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Tempers have flared up between the ZFR and ZWC despite an agreed ceasefire. The ZFR are currently in control of the town, Varpardany, and utilize it as a major supply route on the eastern side of Zimnitrita. The ZWC would like to utilize the route, however, blood will have to be spilled to open the path."\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: Engineers / MAT"\
   ""\
   "OPFOR Composition: Mech. Infantry"\
   "OPFOR Assets: Engineers / BTR-70s / Supply Truck"\
   ""\
   "Time: Late afternoon"\
   ""\
   "Weather: Overcast"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "\"Hey! What are you doing zoning out? Get those fucking mines set! Scouts just radioed a ZWC mechanized platoon headed our way. By the look of it, they have a supply truck with them. Must be trying to force us out to clear a route. The fuel and munitions we are storing here must have put us in their sights. Just hand me the mines; go make sure that any man with a rocket knows that, no matter what, those vics can not get past us.\""
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "\"Gather round. High command has ordered the clearing of a new supply route leading through Varpadany. The only issue is the ZFR is dug in and has enough mines to level Andruhanov. Everything North of the Varpadany river is littered with them. They've been backed by the US for a while now which also means they'll have a ton of munitions and fuel to keep up an extended fight so make sure to torch that stuff on your way through. Oh, one more thing, make sure we retain control of our IFVs and supply truck. Command won't be sending us new ones anytime soon, then again, what would be the point of the supply route if we threw them away?\""
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "Administration"
   m_sTextData "You have preplaced mines in all fields north of the river."\
   ""\
   "Goals simplified:"\
   ""\
   "Complete 4/5 for victory"\
   "- (Req.)Place mines at the marked positions on your map"\
   "- (Req.)Destroy 3 or more IFVs"\
   "- (Req.)Destroy the supply truck"\
   "- (Opt.)Keep the fuel storage intact"\
   "- (Opt.)Keep the munitions storage intact"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "There are, unmarked, preplaced mines in the fields north of the river."\
   ""\
   "Goals simplified: "\
   ""\
   "Complete 3/4 goals for victory"\
   "- (Req.)Clear the minefields that are marked along the MSR cutting through Varpadany"\
   "- (Req.)Retain control of 2 or more BTRs and your supply truck."\
   "- (Opt.)Destroy the gas station storing US munitions"\
   "- (Opt.)Destroy the barn holding US fuel"\
   ""\
   "If the supply truck is starting in the North, the end-point for the surviving vehicles is Varpadany Military base."\
   "If the supply truck is starting in the South, the end-point for the surviving vehicles is Valadim."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{699F692466DC47E5}" {
   m_sTitle "Administration"
   m_sTextData "Win conditions:"\
   ""\
   "- BLU victory if 4/5 goals are accomplished"\
   "- OPF victory if 3/4 goals are accomplished"\
   ""\
   "A tie is not possible."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
 }
 m_iFactionOneRatio 2
 m_iFactionTwoRatio 3
 m_sFactionOneKey "BLU"
 m_sFactionTwoKey "OPF"
