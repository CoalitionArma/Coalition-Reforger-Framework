 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "\"OK, gang, it's time for a little crime spree. The castle ruins have some nice artifacts in transit, the town church has a fortune in gold, and the regimental hall has some valuable art. Get some hostages, secure the goods in the truck, then hold out until the police pause their assault. Rinse and repeat. Finally, we need to escape to a safehouse that I've set up in the port.\" - Bain"\
   ""\
   "BLUFOR Composition: Payday Gang"\
   "BLUFOR Assets: Recon Team"\
   ""\
   "OPFOR Composition: SWAT"\
   "OPFOR Assets: Snipers, Unarmed Helicopter, Unarmed Armored Truck"\
   ""\
   "Time: 1800"\
   ""\
   "Weather: Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "- Take hostages, use them to negotiate."\
   "- Collect the loot from the main church of Andruhanov. Survive until police assault pauses."\
   "- Collect the loot from the castle ruins of Andruhanov. Survive until police assault pauses."\
   "- Collect the loot from the regimental hall of Andruhanov. Survive until police assault pauses."\
   "- Bring the loot to the safehouse at the port of Andruhanov."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "Stop the Payday Gang! Don't damage the treasures, don't hurt hostages, and don't destroy their truck. We might be able to negotiate for the release of hostages."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "If INDFOR is playable, add mission objectives in bullet point list. Add details for each if you feel necessary, but keep it concise."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Value the lives of hostages! Use them to negotiate with the enemy. For example, heisters can release hostages to shorten a police assault. SWAT can intensify the assault if the heisters refuse to negotiate."\
   ""\
   "Don't try to assault the police departments - work around them."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
 }
