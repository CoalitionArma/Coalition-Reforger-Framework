   ""\
   "INTENT"\
   "Dig in, set up minefields, and build emplacements to withstand a large assault from the West"\
   ""\
   "EXECUTION"\
   "Commanders discretion"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A97166B808040E3}" {
