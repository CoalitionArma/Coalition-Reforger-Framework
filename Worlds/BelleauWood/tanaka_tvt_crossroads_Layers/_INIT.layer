 m_aMissionDescriptors {
  COA_MissionDescriptor "{6B1112C5A503377C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Belleau Wood, first light."\
   ""\
   "A US Army platoon (BULLDOG) pushed too far last night and is now cut off in the hamlet on the crossroads south-east of Marigny-en-Orxois. Its relief (HAMMER) is forming up on the Coupru road beyond Paris Farm, 2.7 km away by road."\
   ""\
   "A Russian motor-rifle platoon (BERKUT) has moved into the copse east of the Paris Farm road, between the two."\
   ""\
   "BLUFOR: BULLDOG (cut off, 15) and HAMMER (relief, 25). OPFOR: BERKUT (41), with a BTR-70, two Tigrs and a mortar."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1112C5F61769E7}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "BULLDOG: hold the crossroads. HAMMER: break through and relieve them."\
   ""\
   "YOU WIN if HAMMER links up: at least 4 HAMMER players inside the crossroads (120 m) for 30 seconds, with no more than 2 enemy inside."\
   "You also win if the crossroads still stands after 60 minutes."\
   "You lose if the enemy holds the crossroads for 60 seconds with none of you alive inside."\
   ""\
   "RESPAWN"\
   "BULLDOG: one respawn per slot, at the relief start rather than the crossroads. HAMMER: no respawns - the relief force gets one attempt."\
   ""\
   "ASSETS"\
   "HAMMER: five M1151 Humvees on the road at the relief start. The three unarmed ones come back with each respawn wave if destroyed; the two with M2s do not respawn."\
   ""\
   "EXECUTION"\
   "Commander's discretion. The direct road runs past the copse - expect an ambush."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1112C599D38E4F}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Seize the crossroads before the American relief force links up."\
   ""\
   "YOU WIN if you hold the crossroads (120 m) for 60 seconds with at least 3 of you and no American alive inside it."\
   "You lose if the relief force links up (4 of them inside for 30 seconds), or if the crossroads still stands after 60 minutes."\
   ""\
   "SITUATION"\
   "You form up in the copse east of the Paris Farm road: between the cut-off Americans (1.3 km NW) and their relief column (1.2 km S)."\
   ""\
   "RESPAWN"\
   "No respawns. An admin may respawn the whole side at Lucy-le-Bocage, 2.5 km east of the crossroads, where two Ural trucks and two UAZs wait to bring you back to the fight."\
   ""\
   "ASSETS"\
   "A BTR-70 and two Tigrs (PKM) at the copse. They do not respawn."\
   "BERKUT WPNS carries a 2B14 mortar: the gunner has the baseplate and bipod, the loader the barrel and 10 rounds (5 HE, 5 smoke)."\
   ""\
   "EXECUTION"\
   "Commander's discretion: assault the crossroads, ambush the relief column, or both."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1112C50A6C267B}" {
   m_sTitle "Administration"
   m_sTextData "Wave respawn every 90 seconds, for BULLDOG only."\
   "BULLDOG: one respawn per slot. HAMMER and BERKUT: no respawns. Admins may respawn OPFOR manually (admin menu, Respawn Side)."\
   "Transport vehicles (HAMMER's unarmed Humvees, BERKUT's trucks at Lucy-le-Bocage) come back with each respawn wave if destroyed, at no ticket cost. Armed vehicles do not respawn."\
   ""\
   "The round is decided by the link-up, the seizure or the 60-minute hold. Admins end the mission after the result is announced."\
   ""\
   "Mission by tanaKa-."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 1
