$grp BaseGameTriggerEntity {
 OBJ1 {
  coords 5629.248 162.303 5116.028
  angles 0 37.315 0
  userScript "	// code here"\
  "	"\
  "	int m_iBlufor = 0;"\
  "	int m_iOpfor = 0;"\
  "	"\
  "	void CheckWin()"\
  "	{"\
  "		QueryEntitiesInside();"\
  "		array<IEntity> entities = {};"\
  "		GetEntitiesInside(entities);"\
  "		m_iBlufor = 0;"\
  "		m_iOpfor = 0;"\
  "		foreach (IEntity entity: entities)"\
  "		{"\
  "			if (!entity)"\
  "				continue;"\
  "			"\
  "			SCR_ChimeraCharacter character = SCR_ChimeraCharacter.Cast(entity);"\
  "			if (!character)"\
  "				continue;"\
  "			"\
  "			SCR_DamageManagerComponent damageMan = character.GetDamageManager();"\
  "			if (!damageMan)"\
  "				continue;	"\
  "			"\
  "			if (damageMan.GetState() == EDamageState.DESTROYED)"\
  "				continue;"\
  "			"\
  "			FactionAffiliationComponent factComp = FactionAffiliationComponent.Cast(entity.FindComponent(FactionAffiliationComponent));"\
  "			if (!factComp)"\
  "				continue;"\
  "				"\
  "			Faction faction = factComp.GetAffiliatedFaction();"\
  "			if (!faction)"\
  "				continue;"\
  "			"\
  "			if (faction.GetFactionKey() == \"BLUFOR\")"\
  "				m_iBlufor++;"\
  "			else"\
  "				m_iOpfor++;"\
  "		}"\
  "		"\
  "		if (m_iBlufor == 0)"\
  "			return;"\
  "		"\
  "		if (m_iBlufor > 0 && m_iOpfor == 0)"\
  "			ObjComplete();"\
  "		"\
  "		int totalPlayers = m_iBlufor + m_iOpfor;"\
  "		if ((float)m_iBlufor/totalPlayers > 0.7)"\
  "			ObjComplete();"\
  "	}"\
  "	"\
  "	void ObjComplete()"\
  "	{"\
  "		COA_RplBroadcastManager broadcastMan = COA_RplBroadcastManager.GetInstance();"\
  "		if (!broadcastMan)"\
  "			return;"\
  "		broadcastMan.PopUpNotification(10, \"Southern Trenches have been captured by American forces!\", \"Prepare for the assault on the northern trench\", \"{E3E34E1B0BC94432}Sounds/UI/Samples/Menu/UI_Task_Succeded.wav\");"\
  "		COA_RespawnManager respawnMan = COA_RespawnManager.GetInstance();"\
  "		if (!respawnMan)"\
  "			return;"\
  "		respawnMan.RespawnAllSides();"\
  "		delete this;"\
  "	}"
  TriggerShapeType Sphere
  SphereRadius 93.5
  BoxMins 75 50 250
  PeriodicQueries 1
  UpdatePeriod 5
  OnQueryFinished ""\
  "		#ifdef WORKBENCH"\
  "		#else"\
  "		if (!Replication.IsServer())"\
  "		{"\
  "			delete this;"\
  "			return;"\
  "		}"\
  "		#endif"\
  "		CheckWin();"\
  "	"
 }
 OBJ2 {
  coords 5490.722 176.841 5467.031
  angles 0 37.315 0
  userScript "	// code here"\
  "	IEntity m_OBJ1;	"\
  "	bool m_bOBJ1Found = false;"\
  "	int m_iBlufor = 0;"\
  "	int m_iOpfor = 0;"\
  "	"\
  "	void CheckWin()"\
  "	{"\
  "		QueryEntitiesInside();"\
  "		array<IEntity> entities = {};"\
  "		GetEntitiesInside(entities);"\
  "		m_iBlufor = 0;"\
  "		m_iOpfor = 0;"\
  "		foreach (IEntity entity: entities)"\
  "		{"\
  "			if (!entity)"\
  "				continue;"\
  "			"\
  "			SCR_ChimeraCharacter character = SCR_ChimeraCharacter.Cast(entity);"\
  "			if (!character)"\
  "				continue;"\
  "			"\
  "			SCR_DamageManagerComponent damageMan = character.GetDamageManager();"\
  "			if (!damageMan)"\
  "				continue;	"\
  "			"\
  "			if (damageMan.GetState() == EDamageState.DESTROYED)"\
  "				continue;"\
  "			"\
  "			FactionAffiliationComponent factComp = FactionAffiliationComponent.Cast(entity.FindComponent(FactionAffiliationComponent));"\
  "			if (!factComp)"\
  "				continue;"\
  "				"\
  "			Faction faction = factComp.GetAffiliatedFaction();"\
  "			if (!faction)"\
  "				continue;"\
  "			"\
  "			if (faction.GetFactionKey() == \"BLUFOR\")"\
  "				m_iBlufor++;"\
  "			else"\
  "				m_iOpfor++;"\
  "		}"\
  "		"\
  "		if (m_iBlufor == 0)"\
  "			return;"\
  "		"\
  "		if (m_iBlufor > 0 && m_iOpfor == 0)"\
  "			ObjComplete();"\
  "		"\
  "		int totalPlayers = m_iBlufor + m_iOpfor;"\
  "		if ((float)m_iBlufor/totalPlayers > 0.7)"\
  "			ObjComplete();"\
  "	}"\
  "	"\
  "	void ObjComplete()"\
  "	{"\
  "		COA_RplBroadcastManager broadcastMan = COA_RplBroadcastManager.GetInstance();"\
  "		if (!broadcastMan)"\
  "			return;"\
  "		broadcastMan.PopUpNotification(10, \"Northern Trenches have been captured by American forces!\", \"BLUFOR Victory\", \"{E3E34E1B0BC94432}Sounds/UI/Samples/Menu/UI_Task_Succeded.wav\");"\
  "		delete this;"\
  "	}"
  TriggerShapeType Sphere
  SphereRadius 93.5
  BoxMins 75 50 250
  PeriodicQueries 1
  UpdatePeriod 5
  OnQueryFinished ""\
  "		#ifdef WORKBENCH"\
  "		#else"\
  "		if (!Replication.IsServer())"\
  "		{"\
  "			delete this;"\
  "			return;"\
  "		}"\
  "		#endif"\
  "		if (!m_bOBJ1Found)"\
  "		{"\
  "			m_OBJ1 = GetGame().GetWorld().FindEntityByName(\"OBJ1\");"\
  "			if (!m_OBJ1)"\
  "			{"\
  "				m_bOBJ1Found = true;"\
  "				return;"\
  "			}"\
  "			else"\
  "				return;"\
  "		}"\
  "		CheckWin();"\
  "	"
 }
}
