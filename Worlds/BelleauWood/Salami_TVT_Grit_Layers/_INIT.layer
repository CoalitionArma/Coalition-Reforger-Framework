  COA_MissionDescriptor "{69ED0C6F7649ADC4}" {
   m_sTitle "Mission: Situation"
   m_sTextData "B CO, 2-22 INF have been tasked with assaulting key terrain located on the flank of the Brigades main assault. Defending it is a depleted motor rifle platoon, who's left with only it's dismounted assets after days of drone and artillery strikes."\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets:"\
   "Mortars"\
   "DJIs"\
   ""\
   "OPFOR Composition: Infantry"\
   "OPFOR Assets:"\
   "FPVs"\
   "DJIs"\
   ""\
   "Time: 1300"\
   ""\
   "Weather: Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{69ED0C6F7649AF5F}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "- Capture the southern trenches."\
   "- Capture the northern trenches"\
   ""\
   "INTENT"\
   "The intent is to use your recon drones and tree coverage to set conditions for an assault on the dug in Russian positions. Expect casualties."\
   ""\
   "EXECUTION"\
   "Commanders Discretion."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69ED0C6F7649A859}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "- Defend the southern trenches"\
   "- Defend the northern trenches"\
   ""\
   "INTENT"\
   "Utilize your drone team to hunt high value nato weapon systems that can hit you from beyond LOS. Be careful as if the Americans gain enough momemntum they can capture the Northern trench if your retreat isn't done well."\
   ""\
   "EXECUTION"\
   "Commanders discretion."\
   ""
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69ED0C6F7649A973}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69ED0C6F7649AA6D}" {
