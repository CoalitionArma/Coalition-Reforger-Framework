 m_aMissionDescriptors {
  COA_MissionDescriptor "{6A1724AD8857F945}" {
   m_sTitle "Mission: Situation"
   m_sTextData "In a war torn central european nation in the 1980s, the US has entered the war as a peace keeping force. In order to begin peace keeping operations, the US 1st Cav has been tasked with long range recon patrols to find and destroy the source of FIA weapons in key areas."\
   ""\
   "BLUFOR Composition: Air Assault Infantry"\
   "BLUFOR Assets: 4x UH-1H"\
   ""\
   "OPFOR Composition: Infantry"\
   "OPFOR Assets: 1x MTR"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6A1724AD8857FBEB}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Find and destroy four caches in the greater Belleau Wood area"\
   ""\
   "INTENT"\
   "Utilize your air mobility via UH-1Hs to insert near cache areas and perform long-range recon patrols as squads, separate platoons, or the entire company."\
   ""\
   "EXECUTION"\
   "Commanders discretion - message admin if you have questions"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A1724AD8857FA4C}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Defend the four caches at all costs"\
   ""\
   "INTENT"\
   "Spread out early amongst the four caches and set up defenses. If contact is made, use radio communications to reorganize to the area that is under attack."\
   ""\
   "EXECUTION"\
   "Commanders intent"\
   ""\
   "NOTE"\
   "You may teleport from main to any cache and back to main from any cache. Teleporting will be disabled if enemies are within 250m of the cache."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A1724AD8857FAC6}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A1724AD8857FD2A}" {
   m_sTitle "Administration"
   m_sTextData "If a cache is destroyed, both sides respawn"\
   ""\
   "Helicopters must be spawned by BLUFOR at the helipads. Stick to unarmed and door gun UH-1Hs unless otherwise specified by admins"
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
