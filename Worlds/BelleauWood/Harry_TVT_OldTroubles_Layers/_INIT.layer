 m_aMissionDescriptors {
  COA_MissionDescriptor "{69CF741042A997EC}" {
   m_sTitle "Mission: Situation"
   m_sTextData "British forces are moving quickly inland in France following rail lines. They need to secure the next rail station, and then create a buffer zone by securing a forward defensive position in front of it. Can French defenders blunt the British push?"\
   ""\
   "BLUFOR Composition: Infantry Platoon"\
   "BLUFOR Assets: Platoon Engineer"\
   ""\
   "OPFOR Composition: Oversized Infantry Platoon"\
   "OPFOR Assets: Integrated Demo, Weapons w/ 60mm mortars"\
   ""\
   "Time: 60 Min"\
   "Weather: Day Cloudy"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{69CF741042A98800}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Defend the objectives in order. The victor will control obj 2 at the end of the match. There will be one respawn wave either 35 minutes in, or 3 minutes after admins have determined a force is no longer combat effective."\
   ""\
   "INTENT"\
   "Defenders need to make a delaying attempt on obj 1 without getting thoroughly destroyed, and then mount an effective defense on obj 2."\
   ""\
   "EXECUTION"\
   "The worst case scenario is to over commit to the first objective, be rendered combat inneffective, and let the attackers sieze obj 2 for free. Delaying actions, and understand when to pull back from a fighting position will be critical."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69CF741042A98E5C}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Attack the objectives in order. The victor will control obj 2 at the end of the match. There will be one respawn wave either 35 minutes in, or 3 minutes after admins have determined a force is no longer combat effective."\
   ""\
   "INTENT"\
   "Squads are oversized with demo, integrated MMG, and 60mm mortar. You should be able to create larger volumes of fires, suppressive effects, concealment, and have options for pushing through town. "\
   ""\
   "EXECUTION"\
   "Use your firepower to secure the movement of your troops. Fire without manuever is indecisive. Maneuver without fire is fatal. "
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69CF741042A98D35}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69CF741042A98367}" {
   m_sTitle "Administration"
   m_sTextData "Place any meta or technical information that players should know here. Otherwise, leave empty."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
