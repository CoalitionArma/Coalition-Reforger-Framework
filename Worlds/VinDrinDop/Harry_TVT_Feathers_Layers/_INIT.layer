 m_aMissionDescriptors {
  COA_MissionDescriptor "{6A9D2C5BA70D0DEA}" {
   m_sTitle "Mission: Situation"
   m_sTextData "American troops have been tasked with clearing out weapons caches roughly identified in the AO. "\
   ""\
   "BLUFOR Composition: Air Assault Infantry"\
   "BLUFOR Assets: Armed Huey per Squad, Mortars"\
   ""\
   "OPFOR Composition: Inf"\
   "OPFOR Assets: Demo w/ mines, PLT MMG"\
   ""\
   "Time: 75 min"\
   "Weather: Overcast Dusk"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6A9D2C5BA70D01AB}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Find and destroy the three caches. After each cache destruction there will be a respawn. "\
   ""\
   "INTENT"\
   "Coordinate air support with ground forces to maneuver to contact on scouted cache locations."\
   ""\
   "EXECUTION"\
   "commanders discretion"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9D2C5BA70D008F}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Defend your marked caches. After each cache destruction there will be a respawn wave. "\
   ""\
   "INTENT"\
   "Be proactive in determining enemy location, force concentration, etc."\
   ""\
   "EXECUTION"\
   "The enemy can likely overpower you if you do a simple perimeter defense around the cache."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9D2C5BA70D07C1}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9D2C5BA70D0701}" {
   m_sTitle "Administration"
   m_sTextData "Vehicles and specialties are intended to be respawned and re-armed on cache destruction. "
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
