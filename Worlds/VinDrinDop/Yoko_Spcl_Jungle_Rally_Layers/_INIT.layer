  COA_MissionDescriptor "{6ACD5A1E0000001B}" {
   m_sTitle "Roadbook"
   m_sTextData "Jungle Rally - 6.41 km, point to point on forest and dirt roads, with four short cuts off the road."\
   ""\
   "Grades: 1 is the tightest corner, 6 the fastest. Square: a 90 degree junction. Distances in metres to the next call; into and and mean it follows straight on. Off road: there is no road there, head for where the road picks up again."\
   ""\
   "0.02 km   Stage start, 600"\
   "0.64 km   Left 2, into right 2, into left 3, 100"\
   "0.87 km   Left 4 long, into right 4 opens, 200"\
   "1.23 km   Right 3 long opens, steep downhill, into left 5, 150"\
   "1.48 km   Left 4 long, 400"\
   "1.95 km   Left 4, 150"\
   "2.16 km   At junction right 5 opens, steep uphill, into left 5 opens, and right 3 opens, 70"\
   "2.40 km   Right 3 long tightens, into leave road, off road 80, rejoin road, into left 2 long opens, steep uphill, 150"\
   "2.86 km   At junction square right, into left 3 opens, into right 1 opens"\
   "3.04 km   Left 1 tightens, into leave road, off road 60, rejoin road, 100"\
   "3.25 km   Steep downhill, 90"\
   "3.35 km   At junction right 2 opens, into at junction square left, into at junction right 2"\
   "3.52 km   At junction left 2 long tightens, 200"\
   "3.81 km   Left 4 tightens, into leave road, off road 80, rejoin road, and left 2"\
   "4.01 km   Right 5, 60"\
   "4.13 km   Right 2 long, into left 2, 70"\
   "4.36 km   Left 2 long tightens, into right 3 long, into left 3 opens"\
   "4.56 km   At junction right 2 opens, into left 2 tightens, into right 3 opens"\
   "4.69 km   Left 4, 50"\
   "4.79 km   Left 3 long tightens, 200"\
   "5.10 km   Right 4 long opens, 100"\
   "5.28 km   Left 4 opens, and right 2 long, 100"\
   "5.59 km   Left 4 long tightens, and right 2 long, into hairpin left"\
   "6.03 km   Right 2 opens, into at junction left 3, and left 2 opens, 100"\
   "6.27 km   Leave road, straight 140 over rough to flying finish"
