 m_aMissionDescriptors {
  COA_MissionDescriptor "{6C96E35873F644D9}" {
   m_sTitle "Mission: Situation"
   m_sTextData "US Marines and the PAVN are both after the same intelligence: a relay that keeps moving through the valley. Whoever holds it gets the picture."\
   ""\
   "Neither side has noticed the bodies yet. Something else is out there, and it hunts both of you."\
   ""\
   "BLUFOR Composition: Rifle Platoon (4 squads)"\
   "BLUFOR Assets: 3x M923A1 Trucks"\
   ""\
   "OPFOR Composition: Rifle Platoon (4 squads)"\
   "OPFOR Assets: 3x Ural Trucks"\
   ""\
   "INDFOR: The Hunter (1 player)"\
   ""\
   "Time: 14:00"\
   ""\
   "Weather: Overcast"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{638440454675A0C5}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Hold the active objective. Be the only side inside it (40 m) to score a point a second. Hold it for 2:30 in total to secure it (+60). First to 600 points wins; at 55 minutes the leader wins."\
   ""\
   "INTENT"\
   "The objective moves: when it's secured, or after 8 minutes. The next one is marked straight away and goes live 45 seconds later - get there first."\
   ""\
   "EXECUTION"\
   "Commanders discretion. Keep a squad moving toward where the objective might go next. Don't go anywhere alone - something in the jungle picks off stragglers, and you'll only see it when it's on top of you."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6F81AC4F7AD2A00F}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Hold the active objective. Be the only side inside it (40 m) to score a point a second. Hold it for 2:30 in total to secure it (+60). First to 600 points wins; at 55 minutes the leader wins."\
   ""\
   "INTENT"\
   "The objective moves: when it's secured, or after 8 minutes. The next one is marked straight away and goes live 45 seconds later - get there first."\
   ""\
   "EXECUTION"\
   "Commanders discretion. Keep a squad moving toward where the objective might go next. Don't go anywhere alone - something in the jungle picks off stragglers, and you'll only see it when it's on top of you."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6257CE2C1DD84B14}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Hunt. Both sides are prey. Every kill is announced as a trophy."\
   ""\
   "INTENT"\
   "The objective draws them together - you'll see it on your map too. Pick off stragglers, strike from the trees and vanish."\
   ""\
   "EXECUTION"\
   "[O] Cloak: invisible to anyone further than 4 m. 75 seconds of charge, recharges while off (2 minutes from empty), needs 25% to engage. Any hit breaks it for 6 seconds."\
   "[;] Thermal vision."\
   "You never tire and take 10% of the damage you're dealt. Your body vanishes when you fall - nobody gets your gear. Rebind both keys under Coalition Reforger Framework in the keybindings."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B063936328467E8}" {
   m_sTitle "Administration"
   m_sTextData "Respawns: 90 seconds, 60 tickets per side. The hunter has 2 respawns."\
   "The objective is on the map: green while you hold it, red while the enemy does, orange when contested."\
   "The hunter doesn't hold or contest the objective."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 1
