 m_aMissionDescriptors {
  COA_MissionDescriptor "{6AE632A8C66DCF83}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Admit it. You're lost. Worse, you're behind enemy lines, separated from the other Spike Teams, looking for hidden caches. And your only intel is poorly translated descriptions from interrogated POWs and an amateur map. Okay, time to go back to basics: Field Manual 21-26, Map Reading."\
   ""\
   "BLUFOR Composition: MACV-SOG Spike Teams with helicopters"\
   "BLUFOR Assets: 3x UH-1H helicopters"\
   ""\
   "OPFOR Composition: Vietcong infantry"\
   "OPFOR Assets:"\
   ""\
   "Time: 0800"\
   ""\
   "Weather: Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6AE632A8C66DCC5E}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Multiple MACV-SOG Spike Teams have been inserted into hostile territory. Their mission is to locate enemy caches, identified by some prisoners after lengthy interrogation. The prisoners couldn't mark the positions on a map, but they could describe them verbally."\
   "1. A large round-roofed hut in the fields."\
   "2. An abandoned train car by a bridge."\
   "3. A secret temple on the river. There is a radio tower."\
   "4. A mansion at the base of the mountains."\
   "5. A hidden compound at the end of a river. There is a different temple nearby."\
   ""\
   "INTENT"\
   "Use the map, landmarks, audio, and verbal descriptions to locate other friendly elements and enemy cache locations."\
   ""\
   "EXECUTION"\
   "Find out where you are. Communicate with the other Spike Teams. Find or deduce where the caches are. Destroy the caches. Extract."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AE632A8C66DC32B}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Protect the caches. These are the descriptions that BLUFOR has for the objectives:"\
   "1. A large round-roofed hut in the fields."\
   "2. An abandoned train car by a bridge."\
   "3. A secret temple on the river. There is a radio tower."\
   "4. A mansion at the base of the mountains."\
   "5. A hidden compound at the end of a river. There is a different temple nearby."\
   ""\
   "INTENT"\
   "I think BLUFOR is at a disadvantage because they're split up to start with. Don't ruin their day, but make it fun for them."\
   ""\
   "EXECUTION"\
   "Perform sneaky ambushes or hold down the objective areas."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AE632A8C66DC35C}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AE632A8C66DC2C0}" {
   m_sTitle "Administration"
   m_sTextData "Please, for the sake of the mission, avoid cheesing the land nav with map markers. Use them where logical and reasonable, but don't use them to telepathically communicate every detail."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
