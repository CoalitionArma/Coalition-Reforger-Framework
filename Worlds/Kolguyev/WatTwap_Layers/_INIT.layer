 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Russian training operations on Kolguyev are halted after receiving word that an Mi8 on a test flight was shot down."\
   ""\
   "BLUFOR Composition: Airborne Infantry"\
   "BLUFOR Assets: 2x Mi8s / Urals"\
   ""\
   "OPFOR Composition: Infantry"\
   "OPFOR Assets: MMG / MAT"\
   ""\
   "Time: 2000"\
   ""\
   "Weather: Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "A Mi8 crew has been shot down over Kolguyev. All you know of their whereabouts is that they crash-landed near the Nadezhda mine. "\
   ""\
   "Your objectives are:"\
   "- Locate the crashed Mi8's position"\
   "- Exfil the pilot and crew chief"\
   "- Retain >33% of your force"\
   "Optional:"\
   "- Destroy the radio tower that OPFOR will use to attempt to call for exfil"\
   "(To destroy the tower you must interact with it)"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "In the midst of light reconnassance, a hostile Mi8 flew overhead of a fellow rebel cell. The chance was too great to risk your hideout being notated along with their position, so they made the call to shoot the aircraft down. Now, you must scramble as your plans to cleanse the island of any greater Russian influence have been moved forward. However, this could prove to be more fortuitous than it initially seemed."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "Administration"
   m_sTextData "The crashed Mi8, along with its occupants, is located East of Nadezhda Mine along the riverbed. You are not to move the unconscious pilots as they will serve as your bait. However, once 25 minutes remain, you will be able to radio in a helicopter transport to exfil the pilots and secure victory. (Interact with the radio tower to the East of Nadezhda Mine to call in your extract.) You have outposts within the immediate region to utilize as you see fit."\
   ""\
   "Your objective is:"\
   "- Destroy >66% of the opposing force"\
   "- Exfil the crashed pilot and crew chief"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Your objectives are:"\
   "- Locate the crashed Mi8's position"\
   "- Exfil the pilot and crew chief"\
   "- Retain >33% of your force"\
   "Optional:"\
   "- Destroy the radio tower that OPFOR will use to attempt to call for exfil"\
   "(To destroy the tower you must interact with it)"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
