  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "CHDKz forces have shot down an Mi8. They have located the crash site and have decided to use the surviving pilot as bait to weaken the CDF presence in Kolguyev."\
   ""\
   "OPFOR Composition: CDF"\
   "OPFOR Assets: 2x Mi8s, Urals"\
   ""\
   "INDFOR Composition: CHDKz Infantry"\
   "INDFOR Assets: N/A"\
   ""\
   "Time: Afternoon"\
   ""\
   "Weather: Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "Locate, secure, and extract the crashed helicopter pilot to your spawn; minimize casualties. CHDKz forces can be set up anywhere within ~1km East-West of the OBJ marker; the bowl of Nadezhda Mine is not your friend."\
   ""\
   "You have access to both Mi8s and Urals; you have access to a forward deploy zone to utilize the Urals."\
   ""\
   "Map marker indicates the general vicinity of the crash site. (Within 500 meters)"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "Lay low and cause as many casualties as possible; ensure the enemy do not leave with the pilot. The CDF have access to lightly armed Mi8s to assist with their landing, utilize the space you have to force them into fights they cannot win. "\
   ""\
   "You may not move the unconscious pilot. (He is located to the North of your spawn area along the river.)"\
   ""\
   "INDFOR LOA is the SS area."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "Administration"
   m_sTextData "OPF extract w/ VIP and >25% of force = OPF Victory"\
   "OPF extract w/ VIP and <25% of force = Draw"\
   "OPF fail to extract entirely = IND Victory"
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Place any meta or technical information that players should know here. Otherwise, leave empty."
