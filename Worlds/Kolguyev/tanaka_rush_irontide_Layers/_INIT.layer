COA_Gamemode COA_Lobby : "{6A996BBFCEB37E78}Prefabs/Modded Overrides/Coalition Lobby/COA_Lobby.et" {
 components {
  CRF_CasualtyCounterGamemodeComponent "{6B1109E1CA5C0A01}" {
   m_sMonitoredFaction "BLUFOR"
   m_fCasualtyLimitPercent 250
   m_sWinningFaction "OPFOR"
   m_fAnnounceEveryPercent 50
  }
  CRF_ObjectiveChainGamemodeComponent "{6B1109E1AEAF0007}" {
   m_sAttackerFaction "BLUFOR"
   m_sDefenderFaction "OPFOR"
   m_aObjectives {
    CRF_ObjectiveChainObjective "{6B1109E13FE40ED1}" {
     m_sTitle "Breach the sea wall and control Red Beach"
     m_sDescription "Blow a gap in the sea wall at one of the marked breach points: an engineer with a satchel, an M112 block or a Bangalore sets the charge (10 s fuse). Then hold Red Beach - at least 3 of you on the beach and the slope above it, at most 2 Germans - for 60 seconds."
     m_sDefenderTitle "Hold the sea wall and Red Beach"
     m_sDefenderDescription "Keep the Americans off the beach. Once they blow a gap in the wall, they need 60 seconds with you down to 2 or fewer on the beach and the slope."
     m_sZoneEntityName "irontide_obj_beach"
     m_fRadius 120
     m_fHoldSeconds 60
     m_iMinAttackers 3
     m_iMaxDefenders 2
     m_aBreachPointNames {
      "irontide_breach_1"
      "irontide_breach_2"
      "irontide_breach_3"
      "irontide_breach_4"
      "irontide_breach_5"
      "irontide_breach_6"
     }
     m_iBreachesRequired 1
     m_aRespawnMoves {
      CRF_ObjectiveChainRespawnMove "{6B1109E125258F12}" {
       m_sMarkerEntityName "irontide_spawn_beachhead"
       m_sFaction "BLUFOR"
      }
      CRF_ObjectiveChainRespawnMove "{6B1109E125DDF2F8}" {
       m_sMarkerEntityName "Zone2_OPFOR_Spawn"
       m_sFaction "OPFOR"
      }
     }
    }
    CRF_ObjectiveChainObjective "{6B1109E164F62576}" {
     m_sTitle "Capture the spotting position at the coal silo"
     m_sDescription "The artillery spotters on the silo pad see the whole beach. Take the tower and the observation post next to it: at least 2 of you, at most 1 German, for 45 seconds."
     m_sDefenderTitle "Hold the spotting position at the coal silo"
     m_sDefenderDescription "Hold the tower and the observation post at the coal silo."
     m_sZoneEntityName "irontide_obj_silo"
     m_fRadius 45
     m_fHoldSeconds 45
     m_iMinAttackers 2
     m_iMaxDefenders 1
     m_aRespawnMoves {
      CRF_ObjectiveChainRespawnMove "{6B1109E1C44A8B52}" {
       m_sMarkerEntityName "Zone3_BLUFOR_Spawn"
       m_sFaction "BLUFOR"
      }
      CRF_ObjectiveChainRespawnMove "{6B1109E172AAF0D3}" {
       m_sMarkerEntityName "Zone3_OPFOR_Spawn"
       m_sFaction "OPFOR"
      }
     }
    }
    CRF_ObjectiveChainObjective "{6B1109E168C906D9}" {
     m_sTitle "Capture the garrison (Nadezhda mine)"
     m_sDescription "The German garrison holds the mine yard on the ridge: three huts, the tents and the flag. Clear it and hold it - at least 3 of you, at most 1 German, for 90 seconds."
     m_sDefenderTitle "Hold the garrison (Nadezhda mine)"
     m_sDefenderDescription "The last position. Hold the mine yard."
     m_sZoneEntityName "irontide_obj_garrison"
     m_fRadius 65
     m_fHoldSeconds 90
     m_iMinAttackers 3
     m_iMaxDefenders 1
    }
   }
   m_iTimeLimitMinutes 60
   m_bEndMissionOnVictory 0
   m_fBreachFuseSeconds 10
   m_aBreachChargeKeywords {
    "Explosive_Satchels"
    "DemoBlock_M112"
    "Bangalore"
   }
  }
  CRF_VehicleGearscriptManager "{69F92C24F37D31F8}" {
