       m_sFaction "OPFOR"
      }
      CRF_ObjectiveChainRespawnMove "{6B1109E172AAF0D3}" {
       m_sMarkerEntityName "Zone3_Defender_Spawn"
       m_sFaction "BLUFOR"
      }
     }
    }
    CRF_ObjectiveChainObjective "{6B1109E168C906D9}" {
     m_sTitle "Capture the command post (Nadezhda mine)"
     m_sDescription "The Marine platoon's command post is in the mine yard on the ridge: three huts, the tents and the flag. Clear it and hold it - at least 3 of you, at most 1 Marine, for 90 seconds."
     m_sDefenderTitle "Hold the command post (Nadezhda mine)"
     m_sDefenderDescription "The last position. Hold the mine yard."
     m_sZoneEntityName "irontide_obj_garrison"
     m_fRadius 65
     m_fHoldSeconds 90
     m_iMinAttackers 3
     m_iMaxDefenders 1
    }
   }
   m_iTimeLimitMinutes 60
   m_bEndMissionOnVictory 0
