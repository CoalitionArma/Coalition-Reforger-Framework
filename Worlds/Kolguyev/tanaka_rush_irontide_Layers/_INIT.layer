  CRF_ObjectiveChainGamemodeComponent "{6B1109E1AEAF0007}" {
   m_sAttackerFaction "OPFOR"
   m_sDefenderFaction "BLUFOR"
   m_aObjectives {
    CRF_ObjectiveChainObjective "{6B1109E13FE40ED1}" {
     m_sTitle "Breach the sea wall and control Red Beach"
     m_sDescription "Blow a gap in the sea wall at one of the marked breach points: a sapper with a satchel charge or a TNT block sets the charge (10 s fuse). A blown section leaves a 4 m gap. Then hold Red Beach - at least 3 of you on the beach and the slope above it, at most 2 Marines - for 60 seconds."
     m_sDefenderTitle "Hold the sea wall and Red Beach"
     m_sDefenderDescription "Keep the Russians off the beach. Once they blow a gap in the wall, they need 60 seconds with you down to 2 or fewer on the beach and the slope."
     m_sZoneEntityName "irontide_obj_beach"
     m_fRadius 120
     m_fHoldSeconds 60
     m_iMinAttackers 3
     m_iMaxDefenders 2
     m_aBreachPointNames {
      "irontide_breach_1"
      "irontide_breach_2"
      "irontide_breach_3"
      "irontide_breach_4"
      "irontide_breach_5"
      "irontide_breach_6"
     }
     m_iBreachesRequired 1
     m_aRespawnMoves {
      CRF_ObjectiveChainRespawnMove "{6B1109E125258F12}" {
       m_sMarkerEntityName "irontide_spawn_beachhead"
       m_sFaction "OPFOR"
      }
      CRF_ObjectiveChainRespawnMove "{6B1109E125DDF2F8}" {
       m_sMarkerEntityName "Zone2_Defender_Spawn"
       m_sFaction "BLUFOR"
      }
     }
    }
    CRF_ObjectiveChainObjective "{6B1109E164F62576}" {
     m_sTitle "Capture the observation post at the coal silo"
     m_sDescription "The Marines' forward observers on the silo pad see the whole beach. Take the tower and the observation post next to it: at least 2 of you, at most 1 Marine, for 45 seconds."
     m_sDefenderTitle "Hold the observation post at the coal silo"
     m_sDefenderDescription "Hold the tower and the observation post at the coal silo."
     m_sZoneEntityName "irontide_obj_silo"
     m_fRadius 45
     m_fHoldSeconds 45
     m_iMinAttackers 2
     m_iMaxDefenders 1
     m_aRespawnMoves {
      CRF_ObjectiveChainRespawnMove "{6B1109E1C44A8B52}" {
