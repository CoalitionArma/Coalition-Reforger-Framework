      }
     }
    }
    CRF_Rush_ZoneRespawnConfig "{6B1109E1F61EA413}" {
     m_sZoneName "Zone 2 cleared - silo / mine road"
     m_aRespawnPoints {
      CRF_Rush_RespawnPointEntry "{6B1109E18C1EB43C}" {
