 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Welcome to Dark Business. In this version, OPFOR, INDFOR, and BLUFOR all have something and want something from at least one other faction. "\
   ""\
   "OPFOR has an ammo truck and needs to trade INDFOR for the VIPs"\
   "INDFOR has some VIPs and needs to trade OPFOR for the ammo truck"\
   "BLUFOR wants all of the above"\
   "CIV just wants to survive in any way possible"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "Utilize your littlebird to find, insert, and prevent the trade operations of INDFOR and OPFOR."\
   ""\
   "You need to extract all VIPs"\
   "You need to steal and extract the truck"\
   "You need to all survive"\
   ""\
   "Losing any asset or preventing the trade will result in a mission fail. There are also suppressors in your inventory."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "RP IS REQUIRED"\
   ""\
   "Your objective is to trade your fully loaded ammunition truck to INDFOR so that they can empower their revolution against the Kolguyev Republic."\
   ""\
   "Establish communications with INDFOR leadership and set a place to trade the truck to INDFOR for the VIPs. "\
   ""\
   "Once complete, extract the VIPs back to your camp."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "RP IS REQUIRED"\
   ""\
   "You have captured two OPFOR dignitaries and have negotiated a trade. The dignitaries for the OPFOR ammunition truck. "\
   ""\
   "Establish communications with OPFOR leadership and set a place to trade the VIPs to OPFOR for the ammunition. "\
   ""\
   "Once you have the truck, extract it back to your camp for mission success."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "CIV Objectives"
   m_sTextData "RP IS REQUIRED"\
   ""\
   "You have been captured by INDFOR. They are negotiating a trade for you to return to OPFOR in exchange for a truck of ammunition."\
   ""\
   "You may play this mission however you like, to include allying with any side you want, but your end goal is to escape somehow."
   m_aFactionKeys {
    "CIV"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{694B55FE565E465B}" {
   m_sTitle "Administration"
   m_sTextData "N/A"
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
