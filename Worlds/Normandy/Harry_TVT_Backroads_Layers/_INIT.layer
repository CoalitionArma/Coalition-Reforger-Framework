 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Opfor is moving supplies to build a new FOB. Blufor has teams moving in the area hoping to reduce the number of supplies that make it. This is a two phase mission. In Phase 1, opfor will be transitting the AO trying to get trucks to the marked area. Once they arrive, or are completely destroyed, there will be a respawn for both teams. and a 3 minute pause to allow the defenders to dig in. Then, blufor will be allowed to cross the phase 1 LOA to assault the enemy position. "\
   ""\
   "BLUFOR Composition: Inf"\
   "BLUFOR Assets: Mat Team, Engi Team"\
   ""\
   "OPFOR Composition: Inf"\
   "OPFOR Assets: Supply trucks, Command tent with building station"\
   ""\
   "Time: 60 min"\
   "Weather: Day Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "Stay behind the marked line during phase 1. During phase 1, hunt for OPFOR trucks and try to prevent them from getting to the marked area. These have supplies that they can use to reinforce their position during phase 2. Phase 2 begins when opfor has either arrived at the marked area, or they are completly destroyed. There will be a respawn wave for both teams, and a 3 minute grace period for opfor to reinforce their position. Then, blufor will try to capture the base from opfor. "
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "Your job is to recon supply routes, establish security for them, and then move supplies through them to the marked respawn. The enemy will likely be highly dispersed. "\
   "Phase 2 begins when opfor has either arrived at the marked area, or they are completly destroyed. There will be a respawn wave for both teams, and a 3 minute grace period for opfor to reinforce their position. Then, blufor will try to capture the base from opfor. "
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "If INDFOR is playable, add mission objectives in bullet point list. Add details for each if you feel necessary, but keep it concise."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Place any meta or technical information that players should know here. Otherwise, leave empty."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
 }
