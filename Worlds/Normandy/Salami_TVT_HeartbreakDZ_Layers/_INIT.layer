$grp BaseGameTriggerEntity {
 paradrop {
  coords 2369.883 48.719 2696.281
  userScript "	bool m_bSafeStartInit = false;"\
  "	ref RandomGenerator m_Random;"\
  "	void InitPlane()"\
  "	{"\
  "		EntitySpawnParams spawnParams = new EntitySpawnParams();"\
  "		spawnParams.Transform[3] = \"2672.782 49.736 3927.156\";"\
  "		GetGame().SpawnEntityPrefab(Resource.Load(\"{6B6F6B29ED34E6E1}PrefabsMissionMaking/Systems/SpawnPoints/US_Spawn.et\"), null, spawnParams);"\
  "		"\
  "		IEntity spawnFlag = GetGame().GetWorld().FindEntityByName(\"USSpawn\");"\
  "		if (spawnFlag)"\
  "			SCR_EntityHelper.DeleteEntityAndChildren(spawnFlag);"\
  "		vector dzStart = \"-600 600 7300\";"\
  "        vector dzEnd = \"600 600 3200\";"\
  "        vector dzGreenLight = \"3350 0 0\";"\
  "        float dzAngle = 163+90;"\
  "    "\
  "       "\
  "    "\
  "        SCR_GroupsManagerComponent groupsMan = SCR_GroupsManagerComponent.GetInstance();"\
  "        array<SCR_AIGroup> groups = {};"\
  "        groupsMan.GetAllPlayableGroups(groups);"\
  "    "\
  "        PlayerManager pm = GetGame().GetPlayerManager();"\
  "       "\
  "    	int index = -1;"\
  "		int layer = 0;"\
  "        foreach (SCR_AIGroup group : groups)"\
  "        {"\
  "			"\
  "			 array<int> players = {};"\
  "            if (!group.GetFaction())"\
  "                continue;"\
  "    "\
  "            if (group.GetFaction().GetFactionKey() != \"BLUFOR\")"\
  "                continue;"\
  "    "\
  "            array<AIAgent> agents = {};"\
  "            group.GetAgents(agents);"\
  "    "\
  "            if (agents.Count() == 0)"\
  "                continue;"\
  "    "\
  "            foreach (AIAgent agent : agents)"\
  "            {"\
  "                int playerId = pm.GetPlayerIdFromControlledEntity(agent.GetControlledEntity());"\
  "                if (playerId <= 0)"\
  "                    continue;"\
  "    "\
  "                players.Insert(playerId);"\
  "            }"\
  "			"\
  "			index++;"\
  "			if (index > 2)"\
  "			{"\
  "				layer++;"\
  "				index = 0;"\
  "			}"\
  "				"\
  "			vector flightData[4];"\
  "        	flightData[0] = dzStart;       // Start point"\
  "       		flightData[2] = dzGreenLight;  // Green light point"\
  "        	flightData[3] = dzEnd;         // End point"\
  "			"\
  "			flightData[3][0] = flightData[3][0] + 400 * index;"\
  "			flightData[0][0] = flightData[0][0] + 400 * index;"\
  "			flightData[3][2] = flightData[3][2] + 400 * layer;"\
  "			flightData[0][2] = flightData[0][2] + 400 * layer;"\
  "			"\
  "			//Green light distance changes if we are a layer back"\
  "			flightData[2][0] = flightData[2][0] + 400 * layer;"\
  "			"\
  "			ref CRF_AirdropObject flight = new CRF_AirdropObject("\
  "	            \"BLUFOR\","\
  "	            \"{252AA925952F6888}Prefabs/Vehicles/C47_Drop.et\","\
  "	            flightData,"\
  "	            dzAngle,"\
  "	            players,"\
  "	            true"\
  "	        );"\
  "			 CRF_AirdropManager.GetInstance().InitFlight(flight);"\
  "        }"\
  "  "\
  "        delete this;"\
  "	}"
  TriggerShapeType Sphere
  PeriodicQueries 1
  UpdatePeriod 5
  OnQueryFinished ""\
  "		if (!Replication.IsServer())"\
  "        {"\
  "            delete this;"\
  "            return;"\
  "        }"\
  "		"\
  "		if (!m_Random)"\
  "		{"\
  "			m_Random = new RandomGenerator();"\
  "			m_Random.SetSeed(System.GetUnixTime());"\
  "		}"\
  "		"\
  "        "\
  "        if (!m_bSafeStartInit)"\
  "        {"\
  "            m_bSafeStartInit = CRF_SafestartManager"\
  "                .GetInstance()"\
  "                .GetSafestartStatus();"\
  "        "\
  "            return;"\
  "        }"\
  "        "\
  "		if (!CRF_SafestartManager.GetInstance().GetSafestartStatus() && CRF_RespawnManager.GetInstance().m_bIsParadropEnabled)"\
  "            InitPlane();"\
  "		else if (!CRF_SafestartManager.GetInstance().GetSafestartStatus() && !CRF_RespawnManager.GetInstance().m_bIsParadropEnabled)"\
  "			delete this;"\
  "	"
 }
 mcom_a_trigger {
  coords 804.26 4.309 2854.153
 }
 mcom_b_trigger {
  coords 583.433 48.951 1764.192
 }
}