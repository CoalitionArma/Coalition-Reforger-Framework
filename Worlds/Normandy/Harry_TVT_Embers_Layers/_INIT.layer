 m_aMissionDescriptors {
  COA_MissionDescriptor "{6AD615019EA64DAF}" {
   m_sTitle "Mission: Situation"
   m_sTextData "French resistance in the Normandy region have been smuggling in British and US weaponry, staging for something big. This morning, the Germans grabbed a comrade off the street and beat him until he talked. The time to act is now, before they can destroy the weapons caches. "\
   ""\
   "The French BLUFOR are trying to destroy 80% of the raid objective before German OPFOR destroy all 3 weapons caches. There is not a planned respawn. "\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: Demo"\
   ""\
   "OPFOR Composition:  Infantry"\
   "OPFOR Assets: PLT MMG, Trucks"\
   ""\
   "Time: 70 Min"\
   "Weather: Dusk Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6AD615019EA64032}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Destroy 80% of the raid objectives, or eliminate the enemy, and prevent the enemy from destroying all 3 of your weapons caches."\
   ""\
   "INTENT"\
   "You are an irregular force, and while you have less firepower, you brought more explosives. Balance attack and defense, and don't get in over your head. "\
   ""\
   "EXECUTION"\
   "If you just hold up at a cache, the enemy will destroy you with superior firepower. "
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AD615019EA647AD}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Destroy the three weapons caches, or eliminate the enemy. Prevent the enemy from destroying 80% of the raid objectives."\
   ""\
   "INTENT"\
   "You are the regular force, and able to bring to bear more firepower. Balance attack and defend to get the job done."\
   ""\
   "EXECUTION"\
   "If you simply sit in a building, the enemy will leverage their larger explosive array to destroy you. "
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AD615019EA646D5}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AD615019EA64405}" {
   m_sTitle "Administration"
   m_sTextData "There is no planned respawn. "\
   ""\
   "Raid caches need explosives, but cache hunt caches are interactable. "
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
