 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{6B1126B1A503377C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Normandy, June 1944. 0700, overcast."\
   ""\
   "A German rearguard holds the stone bridge at Sainte Mere and is trucking its supply dump north. A US rifle platoon advances from the south to seize the bridge before the Germans get clear."\
   ""\
   "BLUFOR: US rifle platoon (56). OPFOR: German rearguard platoon (32), three Opel Blitz trucks."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1126B16616C65F}" {
   m_sTitle "BLUFOR OPORD"
   m_sTextData "1. SITUATION"\
   "a. Enemy: German rearguard platoon (32). Holds the Sainte Mere bridge and the hamlet south of it: trench line and 88 mm pit on the south bank, MG34/MG42, Panzerfaust. Three Opel Blitz trucks are moving the supply dump from the bridgehead to the crossroads below Brecourt Manor (1.2 km N). The rearguard follows."\
   "b. Friendly: BAKER, US rifle platoon (56), on foot, 550 m S of the hamlet."\
   "- BAKER 6: PL, PSG, RTO, MO"\
   "- BAKER 1-4: rifle squads (11). 2x BAR team, rifle grenadier, AT rifle grenadier"\
   "- BAKER WPNS: 2x M1919 team, AT rifle grenade team (8)"\
   "c. Terrain: the hamlet sits in a river loop. Crossings: the objective bridge, and the west bridge 230 m W of the hamlet onto the Sainte Mere bank."\
   ""\
   "2. MISSION"\
   "BAKER seizes the Sainte Mere bridge to cut off the German withdrawal."\
   ""\
   "3. EXECUTION"\
   "a. Intent: take the bridge before the dump and the rearguard get clear. Commander's discretion."\
   "b. Victory (any one):"\
   "- Hold the bridge circle (110 m, both banks) for 90 s with no German alive inside."\
   "- Destroy enough loaded trucks that 5 loads cannot get out (8 at the dump)."\
   "- After the last load, fewer than half the surviving Germans reach the extraction point."\
   "- The 50 min clock expires."\
   "- All Germans dead."\
   "c. Defeat: 5 loads delivered, then half the surviving Germans withdraw."\
   "d. Coordinating instructions:"\
   "- One man inside the circle stops all German loading."\
   "- Convoy route: the main street of Sainte Mere, then the north road across open fields, about 1.5 km. Reachable via the west bridge."\
   ""\
   "4. SERVICE SUPPORT"\
   "No respawns. No vehicles. M9A1 rifle grenades are effective against the Opel Blitz."\
   ""\
   "5. COMMAND AND SIGNAL"\
   "Radios: RTOs only (BAKER 6 and each rifle squad)."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1126B1FC834033}" {
   m_sTitle "OPFOR OPORD"
   m_sTextData "1. SITUATION"\
   "a. Enemy: US rifle platoon (56), on foot, advancing from the bocage 550 m S of the hamlet. BAR, M1919, rifle grenades effective against trucks. Outnumbers you almost 2:1."\
   "b. Friendly: rearguard platoon (32)."\
   "- ZUG: PL, PSG, RTO, medic"\
   "- GRUPPE 1-2: rifle squads (9). MG34 team, rifle grenadier, Panzerfaust"\
   "- MG-TRUPP: 2x MG42 team (4)"\
   "- TROSS: truck crews (6). Three Opel Blitz at the truck park."\
   "c. Terrain: the hamlet sits in a river loop. Crossings: the bridge, and the west bridge 230 m W of the hamlet, which gives the enemy a route to the convoy road that bypasses the bridgehead."\
   ""\
   "2. MISSION"\
   "Evacuate the supply dump to the crossroads below Brecourt Manor (1.2 km N), then withdraw."\
   ""\
   "3. EXECUTION"\
   "a. Intent: hold the bridgehead long enough to run the convoy, then pull back under cover. Holding alone loses."\
   "b. Victory: 5 loads delivered, then half your survivors reach the extraction point. Or: all Americans dead."\
   "c. Defeat (any one):"\
   "- The enemy holds the bridge circle (110 m, both banks) for 90 s with none of you inside."\
   "- Loads destroyed: 5 can no longer get out (8 at the dump)."\
   "- The 50 min clock expires."\
   "d. Coordinating instructions:"\
   "- Loading bay: 35 m S of the bridge. One truck at a time, stationary, 75 s."\
   "- Loading pauses while any enemy is inside the circle. Progress is kept."\
   "- Unload at the extraction point: 15 s, truck stationary, one of you aboard."\
   "- A destroyed loaded truck loses its load."\
   "- Route: the bridge, the main street of Sainte Mere, then the north road, about 1.5 km."\
   "- After the last load, anyone reaching the extraction point leaves the round alive."\
   ""\
   "4. SERVICE SUPPORT"\
   "No respawns. Trucks are driven by TROSS; anyone can drive."\
   ""\
   "5. COMMAND AND SIGNAL"\
   "Radios: RTOs only (ZUG)."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1126B10A6C267B}" {
   m_sTitle "Administration"
   m_sTextData "No respawns. Safe start up to 15 min; stay inside your safe-start zone. The 50 min clock starts when the round goes live. The HUD panel shows loads, clock and capture. Admins end the mission after the result."\
   ""\
   "ZEUS: before the round goes live, place three Finest Hour Opel Blitz (Opil_Bletz_transport or _covered) at the German truck park. Only these carry loads."\
   ""\
   "Mission by tanaKa-."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 7
