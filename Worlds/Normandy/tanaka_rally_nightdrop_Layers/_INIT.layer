 m_aMissionDescriptors {
  COA_MissionDescriptor "{6B1113D90000003C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Normandy, the 6th of June 1944, one o'clock in the morning: the hour the paratroopers came down around Sainte Mere. Clear sky, moonlight, and nothing else to see by."\
   ""\
   "The tournament's final stage. It starts in the fields above La Rue and runs 5.9 km east on narrow dirt lanes between the hedgerows, over the high ground in the middle of the map and down into Sainte Mere, finishing on the cobbles of the main street."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1113D90000003D}" {
   m_sTitle "Crew Briefing"
   m_sTextData "MISSION"\
   "Set the fastest stage time, start to finish."\
   ""\
   "EXECUTION"\
   "Crews of two: a driver and a co-driver. You spawn in your crew's car on the farm road north of La Rue, driver at the wheel. The car is held where it stands: crews are called up in slot order, move up to the line when told, and leave one at a time, 30 seconds apart (15 with more than 20 players)."\
   ""\
   "It's night. Turn your headlights on before your start."\
   ""\
   "DRIVER: you won't get the pace notes on screen. Your co-driver calls them, so listen to them and keep your eyes on the road. The full roadbook is in the next briefing tab."\
   ""\
   "CO-DRIVER: at each checkpoint a hint gives you the calls for the road ahead. Every pace note is also on your map, numbered, as an orange dot at its corner, along with the checkpoints. Read the next corners out early."\
   ""\
   "The lanes are narrow and side roads are blocked with tyre stacks. Every checkpoint has to be crossed in order. Jumping your start costs 10 seconds. After the finish, slow down and pull over in the town: keep the main street clear for the crews behind you."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1113D90000003E}" {
   m_sTitle "Roadbook"
   m_sTextData "Night Drop - 5.89 km, point to point: dirt lanes, then the cobbles of Sainte Mere to the finish."\
   ""\
   "Grades: 1 is the tightest corner, 6 the fastest. Square: a 90 degree junction. Distances in metres to the next call; into and and mean it follows straight on."\
   ""\
   "0.03 km   At junction left 1 long opens, into right 2 tightens, and left 3 tightens, 20"\
   "0.31 km   Right 1, into steep uphill, 60"\
   "0.38 km   At junction right 6 tightens, into left 2 long tightens, into right 4 tightens, 20"\
   "0.68 km   Left 3, and left 4 opens, and right 4, 100"\
   "0.96 km   Right 2 opens, into left 2 long, into steep downhill, 300"\
   "1.32 km   Caution, left 2 tightens, into right 3, 250"\
   "1.69 km   Right 3 opens, and right 2 tightens, into left 2, 20"\
   "1.83 km   Right 3 opens, into left 5, 150"\
   "2.11 km   Right 2, into steep uphill, 300"\
   "2.40 km   Caution, at junction square right, and right 4 opens, into square right at junction, 20"\
   "2.63 km   Left 2, into steep downhill, 150"\
   "2.79 km   Left 5 tightens, 350"\
   "3.19 km   At junction left 3 opens, and right 5, into left 3 opens at junction, 150"\
   "3.54 km   At junction left 4, 80"\
   "3.68 km   Left 5 opens, into square right at junction, and right 2 tightens, 20"\
   "3.85 km   Right 3 tightens, into left 4, into steep uphill, 200"\
   "4.13 km   Right 4, 100"\
   "4.32 km   Right 4 tightens, 150"\
   "4.54 km   Steep downhill, into left 4 opens, 70"\
   "4.72 km   Left 5, into right 4 tightens, into left 3 long, 100"\
   "5.07 km   At junction right 4 opens, into crest, and left 4 at junction, 90"\
   "5.30 km   Onto cobbles, and right 3 opens, into hairpin left at junction, 100"\
   "5.65 km   Left 5, and crest, 100"\
   "5.81 km   Flying finish"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1113D90000003F}" {
   m_sTitle "Administration"
   m_sTextData "Rally stage, the tournament final. No respawns: a crashed crew is out. Night all stage long; turn your headlights on."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
