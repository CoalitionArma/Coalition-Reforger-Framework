COA_Gamemode COA_Lobby : "{6A996BBFCEB37E78}Prefabs/Modded Overrides/Coalition Lobby/COA_Lobby.et" {
 components {
  CRF_ObjectiveChainGamemodeComponent "{6B1119A1AEAF0007}" {
   m_sAttackerFaction "BLUFOR"
   m_sDefenderFaction "OPFOR"
   m_iTimeLimitMinutes 60
   m_bEndMissionOnVictory 0
   m_fBreachFuseSeconds 10
   m_aBreachChargeKeywords {
    "Explosive_Satchels"
    "DemoBlock_M112"
    "Bangalore"
   }
   m_aObjectives {
    CRF_ObjectiveChainObjective "{6B1119A13FE40ED1}" {
     m_sTitle "Breach the draw wall and control Red Beach"
     m_sDescription "The only way off the beach is the draw road at its west end, and the Germans have walled it shut. Blow a gap at one of the marked breach points: an engineer with a satchel, an M112 block or a Bangalore sets the charge (10 s fuse). Then hold Red Beach - at least 3 of you on the beach, the road terrace and the draw, at most 2 Germans - for 60 seconds."
     m_sDefenderTitle "Hold the draw wall and Red Beach"
     m_sDefenderDescription "Keep the Americans on the sand. Once they blow a gap in the draw wall, they need 60 seconds with you down to 2 or fewer on the beach, the road terrace and the draw."
     m_sZoneEntityName "irontide_obj_beach"
     m_fRadius 120
     m_fHoldSeconds 60
     m_iMinAttackers 3
     m_iMaxDefenders 2
     m_iBreachesRequired 1
     m_aBreachPointNames {
      "irontide_breach_1"
      "irontide_breach_2"
      "irontide_breach_3"
      "irontide_breach_4"
      "irontide_breach_5"
      "irontide_breach_6"
     }
     m_aRespawnMoves {
      CRF_ObjectiveChainRespawnMove "{6B1119A125258F12}" {
       m_sMarkerEntityName "irontide_spawn_beachhead"
       m_sFaction "BLUFOR"
      }
      CRF_ObjectiveChainRespawnMove "{6B1119A125DDF2F8}" {
       m_sMarkerEntityName "Zone2_OPFOR_Spawn"
       m_sFaction "OPFOR"
      }
     }
    }
    CRF_ObjectiveChainObjective "{6B1119A164F62576}" {
     m_sTitle "Capture Hubert"
     m_sDescription "The German artillery spotters and the platoon's reserve sit in Hubert, the village on the bluff 350 m south of the beach. Take the village square: at least 2 of you, at most 1 German, for 45 seconds."
     m_sDefenderTitle "Hold Hubert"
     m_sDefenderDescription "Hold the village square of Hubert."
     m_sZoneEntityName "irontide_obj_hubert"
     m_fRadius 60
     m_fHoldSeconds 45
     m_iMinAttackers 2
     m_iMaxDefenders 1
     m_aRespawnMoves {
      CRF_ObjectiveChainRespawnMove "{6B1119A1C44A8B52}" {
       m_sMarkerEntityName "Zone3_BLUFOR_Spawn"
       m_sFaction "BLUFOR"
      }
      CRF_ObjectiveChainRespawnMove "{6B1119A172AAF0D3}" {
       m_sMarkerEntityName "Zone3_OPFOR_Spawn"
       m_sFaction "OPFOR"
      }
     }
    }
    CRF_ObjectiveChainObjective "{6B1119A168C906D9}" {
     m_sTitle "Capture the garrison (88 mm battery)"
     m_sDescription "The German garrison holds the battery position in the fields 600 m east of Hubert: trenches, bunkers, the guns and the flag. Clear it and hold it - at least 3 of you, at most 1 German, for 90 seconds."
     m_sDefenderTitle "Hold the garrison (88 mm battery)"
     m_sDefenderDescription "The last position. Hold the battery."
     m_sZoneEntityName "irontide_obj_garrison"
     m_fRadius 65
     m_fHoldSeconds 90
     m_iMinAttackers 3
     m_iMaxDefenders 1
    }
   }
  }
  CRF_CasualtyCounterGamemodeComponent "{6B1119A1ABE64EF6}" {
   m_sMonitoredFaction "BLUFOR"
   m_fCasualtyLimitPercent 250
   m_sWinningFaction "OPFOR"
   m_fAnnounceEveryPercent 50
  }
  CRF_VehicleGearscriptManager "{69F92C24F37D31F8}" {
   m_fSpawnClearanceRadius 2
  }
  SCR_TimeAndWeatherHandlerComponent "{64427EEC304DD9A0}" {
   m_bRandomStartingWeather 0
   m_aStartingWeatherAndTime {
    SCR_TimeAndWeatherState "{66EE8AEC3605B974}" {
     m_sWeatherPresetName "Overcast"
     m_iStartingHour 7
     m_iStartingMinutes 0
    }
   }
   m_bRandomWeatherChanges 0
  }
 }
 coords 0 0 0
 m_bRespawnEnabled 0
 m_bWaveRespawn 0
 m_bRallyPointsEnabled 0
 m_iTimeToRespawn 60
 m_iRespawnCutoffMinutes 0
 m_eRespawnMode 0
 m_iTimeLimitMinutes 65
 m_bLockUnusedSlots 1
 m_bUseSafestartTimeLimit 1
 m_iSafestartTimeLimit 15
 m_bUseCVON 1
 m_aMissionDescriptors {
  COA_MissionDescriptor "{6B1119A1A503377C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Normandy, 6 June 1944, 0700. Overcast, calm sea."\
   ""\
   "Red Beach is the west end of the long beach below the village of Hubert. Hedgehogs and log ramps cover the sand. A concrete sea wall runs along the top of it, with the coast road on a terrace behind, and behind that a bluff 40 m high. The only way up is the draw road at the west end of the beach, and the Germans have sealed it with a concrete wall from the cliff down to the sea wall. Four Tobruk MG pits and two MG nests sit on the bluff edge. Hubert lies 350 m south of the beach on the plateau; 600 m east of it a battery of 88 mm guns is dug in with trenches and bunkers."\
   ""\
   "US infantry are loading into LCVPs at a staging pontoon in the bay behind the headland, 400 m west of the beach."\
   ""\
   "BLUFOR: US Army rifle platoon (1PLT, 1-1 to 1-4, WPNS); the weapons squad has the platoon's engineers. A 105 mm M2A1 howitzer section (ARTY) fires from its own pontoon 1.6 km further west. Eight LCVPs."\
   "OPFOR: German infantry platoon, 1944 (ZUG, GRUPPE 1-3, MG-TRUPP). Dug in, no vehicles."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6B1119A1F61769E7}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Three objectives, one after another (the task list shows the open one and its progress):"\
   "1. Breach the draw wall and control Red Beach."\
   "2. Capture Hubert."\
   "3. Capture the garrison (88 mm battery)."\
   ""\
   "1. RED BEACH"\
   "The sea wall at the top of the sand is a retaining wall, too high to climb: get onto the road terrace behind it by the stairs at the east end of Red Beach or around the wall's west end. From the terrace the draw road climbs west to the plateau, and a concrete wall blocks it from the cliff down to the sea wall. Six sections of that wall are breach points (marked on your map), two on the road and four down the slope: an engineer with a satchel, an M112 block or a Bangalore uses \"Place breaching charge\" on the east side of one. The charge is used up and the section blows 10 seconds later - get clear. One breach is enough. Then hold Red Beach (the beach, the terrace and the draw): at least 3 of you, at most 2 Germans, for 60 seconds."\
   "2. HUBERT"\
   "The village on the plateau, 350 m south of the beach up the draw road. Take the square: at least 2 of you, at most 1 German, for 45 seconds."\
   "3. 88 MM BATTERY"\
   "The garrison holds the battery position in the fields 600 m east of Hubert: trenches, bunkers, the guns and the flag. At least 3 of you, at most 1 German, for 90 seconds."\
   "If nobody is there to hold a zone, its progress drains; contested, it holds."\
   ""\
   "EXECUTION"\
   "Each element spawns on the pontoon next to its own LCVP: step down into the boat, the squad lead or a volunteer drives. Leave the bay to the east, round the headland and run along the shore: Red Beach starts 300 m past the headland. The water off the beach is shallow all the way out and the sand is covered in hedgehogs and log ramps - pick a clear stretch. Two spare LCVPs wait at the east end of the dock. The run in takes two to three minutes. Do not land west of the sea wall's end: that pocket of beach under the headland is out of bounds, as is everything east of the stairs."\
   ""\
   "ENGINEERS (WPNS): four combat engineers, each with a Bangalore torpedo, three satchel charges, an M112 block and a blasting machine - every one of them can blow a breach point."\
   "HOWITZER (ARTY): a 105 mm M2A1 on its own pontoon (HOWITZER on the map) off the north coast, laid towards the beach. Two crates next to the gun hold 60 HE (M1) and 100 white phosphorus smoke (M60) rounds - that is all there is. Take a shell from a crate, set its charge, load it into the gun. The section chief and the gunner carry the firing table. The beach and Hubert are about 2.1 km away, the battery 2.7 km. A dead gun crew respawns with everyone else, at BLUFOR's current spawn."\
   ""\
   "No timed respawns: when an objective falls, everyone dead comes back - after the beach on the road terrace behind the sea wall, after Hubert on the east edge of the village."\
   ""\
   "CASUALTIES: the platoon can take two and a half times as many casualties as it has men when safe start ends. Every death counts, again after a respawn. Reach that and the Germans win (the pause menu shows the count)."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1119A199D38E4F}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Hold three positions, one after another: the draw wall and Red Beach, the village of Hubert, the 88 mm battery."\
   ""\
   "EXECUTION"\
   "You start on the bluff above the beach. The Americans land below you and cannot get up the bluff anywhere but the draw road at the west end, which is walled shut from the cliff to the sea wall. Four Tobruk MG pits sit on the bluff edge, one MG nest covers the top of the draw road and one enfilades the beach from the east."\
   "The Americans have to blow a gap in the draw wall first: you are warned when a breaching charge is set (10 s). After that they take the beach if they hold it for 60 seconds with 2 or fewer of you on the beach, the road terrace and the draw - men on the bluff do not count."\
   "When a position falls, everyone dead comes back at the next one: the fields south of Hubert for the village, behind the battery for the last stand."\
   "You have no vehicles. Each Gruppe has an MG34 and a Panzerfaust (one shot: save it for a boat), and its grenadier has rifle grenades. The MG-Trupp has two MG42s. Your only medic is the Zug's Sanitaeter."\
   ""\
   "YOU WIN if the Americans have not taken all three when the time limit (60 minutes) runs out, if they are wiped out, or if they reach their casualty limit (two and a half times the men they had when safe start ended; every death counts, again after a respawn; the pause menu shows the count)."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6B1119A10A6C267B}" {
   m_sTitle "Administration"
   m_sTextData "Objective chain, 3 objectives. Time limit 60 minutes after safe start (safe start max. 15 minutes)."\
   ""\
   "No timed respawns. When an objective falls, every dead player of both sides respawns at their side's new spawn. Each spawn also updates after each objective."\
   ""\
   "Casualty limit: BLUFOR, 250% of its players when safe start ends. This means there can be three respawn waves (300%), but if the 3rd respawn wave receives over 50% casualties, it's a mission fail for BLU. It's announced, but the mission doesn't end by itself - end it from the admin menu."\
   ""\
   "LCVPs: 8 at the staging pontoon (one each for 1PLT, 1-1 to 1-4 and WPNS, + 2 spares). A destroyed LCVP is respawned at the pontoon for free when an objective falls. Nothing else respawns: not the M2A1 howitzer, and not its 60 HE + 100 smoke rounds."\
   ""\
   "Mission by tanaKa-."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
 m_iFactionOneRatio 2
