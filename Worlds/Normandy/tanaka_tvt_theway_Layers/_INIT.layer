 m_aMissionDescriptors {
  COA_MissionDescriptor "{6A9B2093E08E8611}" {
   m_sTitle "Mission: Situation"
   m_sTextData "German forces are in full retreat from Normandy beach. Airborne forces has been inserted behind enemy lines this morning and are attempting to cut off and destroy any retreating German forces before they can rally deeper in the bocage."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6A9B2093E08EBF8B}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Destroy all German forces retreating Southwards from Normandy beach"\
   ""\
   "INTENT"\
   "Utilize your RTOs to detect radio frequency directions, hone in on German forces, and destroy them."\
   ""\
   "EXECUTION"\
   "Spread out and utilize the radio detection framework RTOs have to triangulate enemy transmissions North of you."\
   ""\
   "NOTE"\
   "They may be speaking to regional command. Any radio detection Southwards does not indicate retreating units."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9B2093E08EBE99}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Retreat Southwards away from Normandy beach and rally at the regimental HQ"\
   ""\
   "INTENT"\
   "Utilize your RTO to communicate to regiment and order fires. You must do at least 10 minutes of total radio communication while retreating."\
   ""\
   "EXECUTION"\
   "Commanders discretion. Get to regiment!"\
   ""\
   "MORTARS"\
   "Provide support as requested"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9B2093E08EB10B}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9B2093E08EB19C}" {
   m_sTitle "Administration"
   m_sTextData "N/A"
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
