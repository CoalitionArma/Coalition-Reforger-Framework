 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "An American Artillery battery has been ambushed by INDFOR and lost two of its guns. US forces head to the town of Murabat to retrieve them."\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: Trucks, M2 HMMWVs, MMG Team"\
   ""\
   "OPFOR Composition: Infantry"\
   "OPFOR Assets: 2x M777, Recon Team, AT Mines, Special equipment"\
   ""\
   "Time:"\
   ""\
   "Weather:"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "• Retrieve the 2 M777s"\
   "• Move them to the drop off site."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "If OPFOR is playable, add mission objectives in bullet point list. Add details for each if you feel necessary, but keep it concise."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "• Defend the two howitzers until Omar arrives with the trucks (20 min)"\
   "• Move the guns to the drop off site."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Mission ends when both howitzers are on a drop off point, or faction wipe. "\
   "The howtizers can be towed with a user action found on the end of the barrel. Deployment action is on the left wheel. Handbreak in on the right wheel. "\
   "Any INDFOR team may use the howitzers (at the commander's discretion), but they will play a naive gun crew (No range table will be provided, online calculators are prohibited)."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{68D833DD27772220}" {
   m_sTitle "Commander's Notes"
   m_sTextData "One of our artillery batteries on route to FOB Thirty Palms was ambushed by INDFOR less than an hour ago, and has lost two guns to the enemy. Fortunetly the ammo truck got away, so INDFOR has limited ammo."\
   "A Recon drone has managed to track INDFOR to the town of Marubat. Looks like the trucks broke down. They may have new trucks on the way. This will be our only oppertunity to get the guns back."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{68D833DD2777230D}" {
   m_sTitle "Commander's Notes"
   m_sTextData "Just our luck. After a successful abush and aquisition of US equipment, the trucks break down."\
   "I've already spoke to Omar on the phone, and he says he can get new trucks to us in about 20 minutes. "\
   "One of the men has reported sightings of a US drone. I'm sure American soldiers will soon be here. We'll need to defend the howitzers until the new trucks arrive."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{68DD64CE2AB54BBB}" {
   m_sTitle "INTEL"
   m_sTextData "There's some spare special equipment near the house on the hill to the North West. It's hidden under some bushes."\
   ""\
   "One use launchers have been placed within the BMP wreck in the unamed hamlet to the West."\
   ""\
   "There's a break in the southern border wall."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{68DD64CE2AB548BC}" {
   m_sTitle "INTEL"
   m_sTextData "Analysis of the ambush area reveil spent RPG75 tubes, AT mines, and 7.62 casings."\
   "Previous patrols in the area have taken contact from the hill house, as well as a fire fight within the unnamed hamlet. The areas surrounding those locations should be considered hostile."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
