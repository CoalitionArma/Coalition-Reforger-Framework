  COA_MissionDescriptor "{6ABA2AAD121FC59C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Tensions in the post-war restructuring of the world spill over, and Russians have landed in Alaska. They are gaining ground rapidly, and US troops try to pull back supply from exposed forward bases. There will be a respawn wave after the forward supply base falls."\
   ""\
   "BLUFOR Composition: Inf"\
   "BLUFOR Assets: PLT MMG"\
   ""\
   "OPFOR Composition: Moto Inf"\
   "OPFOR Assets: PLT MMG, Mortars"\
   ""\
   "Time: 60 mm"\
   "Weather: Day Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6ABA2AAD121FFF04}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Defend the forward supply base until all supply has been pulled back, and then defend the fall back position. "\
   ""\
   "INTENT"\
   "You need to slow OPFOR down as any supply left at the forward position gives them materiel to attack you with. "\
   ""\
   "EXECUTION"\
   "Commander's discretion. "
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6ABA2AAD121FFE2D}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Sieze the forward supply base before the enemy can empty it, and use the materiel to attack the fall back position. "\
   ""\
   "INTENT"\
   "Mortars start with very little ammo. Supply siezed from the base can be transported back to generate rounds with. "\
   ""\
   "EXECUTION"\
   "Commanders Discretion"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6ABA2AAD121FFDC7}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6ABA2AAD121FFC0B}" {
   m_sTitle "Administration"
