  COA_MissionDescriptor "{6AB31B454AC67BED}" {
   m_sTitle "Mission: Situation"
   m_sTextData "With the Russian invasion of Alaska, the 101st Airborne have been deployed to assist marine and navy units in the region with retaking key infrastructure."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6AB31B454AC67CAF}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Resecure Camp Ridgeway"\
   ""\
   "INTENT"\
   "Work with MARSOC to disable both QRF and AAA sites at the same time without raising alarm. Once both are dealt with, converge on Ridgeway together and sweep all enemy forces."\
   ""\
   "EXECUTION"\
   "Utilize air mobility to identify and disable the Russian QRF garrison at the local fort. Once done, work with MARSOC to ensure airspace defenses are clear and secure the camp."\
   ""\
   "Movement is PL discretion otherwise."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AB31B454AC67F26}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "Await zeus brief"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AB31B454AC67FAB}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Resecure Camp Ridgeway"\
   ""\
   "INTENT"\
   "Destroy the AAA site preventing the 101st from getting close to the camp. Once done, work with them to resecure the camp while dealing with any QRF that may have escaped containment at the local fort."\
   ""\
   "EXECUTION"\
   "Move on foot and destroy the AAA site as well as all MANPAD assets in the area. Radio to the 101st once done. SL discretion otherwise."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AB31B454AC67E36}" {
   m_sTitle "Administration"
   m_sTextData "BLU respawns are event-based. INDFOR will not respawn. If you are killed as an INDFOR player, switch to a blufor slot."
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
