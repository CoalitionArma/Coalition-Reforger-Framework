 m_aMissionDescriptors {
  COA_MissionDescriptor "{6AF0F438B36C9695}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Russian recon, and signal units have infiltrated into US territory. They are working to hunt for priority targets, and then signal to observers their location for artillery bombardment. US are trying to triangulate the radio transmissions, and responding to mortar reports. "\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: Recon Huey"\
   ""\
   "OPFOR Composition: Infantry"\
   "OPFOR Assets: Mortars w/ Artillery Signalling"\
   ""\
   "INDFOR Composition: Recon"\
   "INFOR Assets: N/A"\
   ""\
   "Time: 70 min"\
   "Weather:  Night Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6AF0F438B36C9A1D}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Find and destroy either the mortar teams, or the recon that's infiltrated."\
   ""\
   "INTENT"\
   "Use a combination of the helicopter, and the radio transmission indicator to locate the enemy. The helicopter has a flood light attached to the bottom of it. "\
   ""\
   "EXECUTION"\
   "It's unlikely, but if the enemy decides to target you with a red illumination mortar round, you have 30 seconds to displace. "
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AF0F438B36C9B59}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Coordinate with the Indfor recon element to find, and destroy the raid objectives. Use the artillery signal mortar to call in a large offshore bombardment."\
   ""\
   "INTENT"\
   "Fire and displace, or risk a direct confrontation with a larger enemy element. Be mindful your radio communications are being tracked. "\
   ""\
   "EXECUTION"\
   "Do not fire danger close on yourself. There is a marked limit of advance, as well as a minimum limit of fire for the artillery shells. Be mindful of hitting friendly recon, the bombardment is very large. "
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AF0F438B36C9BF0}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Read the intelligence you've been given to find each of the raid objectives, then communicate their location to the friendly OPFOR who will fire a red signal mortar to call in an offshore bombardment. "\
   ""\
   "INTENT"\
   "You should avoid direct conflict. You are operating in a recon capacity. Be mindful your radio transmissions are being monitored. "\
   ""\
   "EXECUTION"\
   "Be mindful of the wind, or where the artillery signal might drift. The bombardment is very large. "
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AF0F438B36C9818}" {
   m_sTitle "SHARED FREQUENCY"
   m_sTextData "Your shared  frequency is 57000. You may need to program your radios on a spare channel to that frequency to hear each other. "
   m_aFactionKeys {
    "INDFOR"
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AF1457977CC1F2D}" {
   m_sTitle "AA Intel"
   m_sTextData "Intel says there are two AA positions guarding the entrance to this valley. One is on Thistleback Hill, and one was referenced off of Clearwater Falls. "
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AF145782A82C4F0}" {
   m_sTitle "Fuel Depot Intel"
   m_sTextData "There is a re-fuel point somewhere on the road NW of the river between the crossings at Butler Point and Bradley Point."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AF14578531B66AD}" {
   m_sTitle "Artillery Intel"
   m_sTextData "We've received counterbattery from somewhere in the SW of the AO, across the river from your starting position. "
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AF1457F25C8D00B}" {
   m_sTitle "Vehicle Depot Intel"
   m_sTextData "We believe that there is a vehicle depot somewhere near or in Moose Meadow. Between Whispering lake, and the souther edge of the AO. If you hit the eastern creek, you've gone too far."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6AF443A69862ABD3}" {
   m_sTitle "Administration"
   m_sTextData "N/A"
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
