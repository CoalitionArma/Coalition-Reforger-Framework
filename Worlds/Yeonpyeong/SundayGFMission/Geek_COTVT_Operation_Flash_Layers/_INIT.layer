    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "Disclaimer"
   m_sTextData "Please be advised that there may be gear issues. "\
   ""\
