 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "The Republic Enforcers of the United Earth Republic's United Solar Command deploy to a planet in the Aridias System to secure a landing zone for further operations in the system. In response, the CIW have deployed a unit of commando droids to attempt to halt the unrelenting advance."\
   ""\
   "BLUFOR Composition: 1x Company Element, 2x Rifle Platoons, 2x Vehicle Crews and 2x Air Crews."\
   "BLUFOR Assets: IFVs, Dropships and CAS aircraft."\
   ""\
   "OPFOR Composition: 1x Undersized Rifle Platoon and an AI battalion."\
   "OPFOR Assets: Anti-Tank launchers."\
   ""\
   "Time: 8:30am"\
   ""\
   "Weather: Cloudy"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "Tickets: 50."\
   ""\
   "Objectives:"\
   "- Capture Villa and search for intel."\
   "- Capture BARS Station and prevent a CIW radio broadcast by destroying the radio towers."\
   "- Capture Cheongmyeong and search for any surviving civilians or evidence of war crimes."\
   ""\
   "Note: "\
   "The CIW have deployed a commando unit that are going to try and stop you from completing your objectives."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "Tickets: N/A."\
   "Prevent BLUFOR forces from completing their objectives as best as possible."\
   ""\
   "Note: The CIW arsenal may be missing a few items, please contact Admins/GMs if this is the case."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "If INDFOR is playable, add mission objectives in bullet point list. Add details for each if you feel necessary, but keep it concise."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Mission time: 60 minutes."\
   "Respawns will cut off 5 minutes before mission end."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{69512912CCE19EBC}" {
   m_sTitle "Disclaimer"
   m_sTextData "Please be advised that there may be gear issues. "\
   ""\
   "Please inform the admins and we will resolve where appropriate. There will also be arsenal boxes available for use when needed."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
 }
