  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "The Republic Enforcers of the United Earth Republic's United Solar Command deploy to a planet in the Aridias System to secure a landing zone for further operations in the system. In response, the CIW have deployed a unit of commando droids to attempt to halt the unrelenting advance."\
   ""\
   "BLUFOR Composition: 1x Company Element, 3x Rifle Platoons, 2x Jump Trooper Teams, 2x Sniper Teams, 2x Vehicle Crews and 2x Air Crews."\
   "BLUFOR Assets: IFVs, Dropships and CAS aircraft."\
   ""\
   "Time: 8:30am"\
   ""\
   "Weather: Cloudy"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "Tickets: 75."\
   ""\
   "Objectives:"\
   "- Capture Villa and search for intel."\
   "- Capture BARS Station and prevent a CIW radio broadcast by destroying the radio towers and radar dishes that are clearing the airwaves."\
   "- Capture Cheongmyeong and search for any surviving civilians or evidence of war crimes."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "Administration"
   m_sTextData "Mission time: 60 minutes."\
   "Respawns will cut off 5 minutes before mission end."
