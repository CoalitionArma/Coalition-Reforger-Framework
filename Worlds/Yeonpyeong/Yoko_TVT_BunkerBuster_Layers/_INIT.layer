  COA_MissionDescriptor "{6A7B15B91E6723C8}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Destroy each MCOM in order."\
   ""\
   "INTENT"\
   "Be prepared for a fortified enemy postions and be wary of Marked OPFOR Minefields. Anyone can disarm the mines. Mcom C is underground, multiple entrances exist to get in there."\
   ""\
   "EXECUTION"\
   "Commanders discretion"\
   ""
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A7B15B91E672414}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Defend each Mcom in order"\
   ""\
   "INTENT"\
   "BLUFOR has already landed on the island, luckly you were able to set up minefields on all major routes around the island. You have also been giving sandbags to help fortified postion you deem worthy."\
   ""\
   "Once you teleport you cannot teleport back, make sure you teleport to the correct Mcom."\
   ""\
   "EXECUTION"\
   "Commanders discretion"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A7B15B91E6724EB}" {
