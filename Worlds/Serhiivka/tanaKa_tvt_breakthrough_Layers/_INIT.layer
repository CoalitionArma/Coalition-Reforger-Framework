  COA_MissionDescriptor "{69FD66EAB8B110B9}" {
   m_sTitle "Mission: Situation"
   m_sTextData "CDF forces who are low on supplies are attempting to break through French lines in order to secure more supplies for their war effort"\
   ""\
   "BLUFOR Composition: Motorized Infantry"\
   "BLUFOR Assets: 1x HAT Team, 1x VTT"\
   ""\
   "OPFOR Composition: Mechanized Infantry"\
   "OPFOR Assets: 2x BMP-2"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{69FD66EAB8B11516}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Prevent OPFOR from breaking through and stealing our supplies while extracting our supply cache"\
   ""\
   "INTENT"\
   "Create a  defense in depth (DO NOT SIT IN ONE AREA) on the Western edge of the safestart border in order to hit and run against OPFOR forces until all supplies are extracted to the airfield"\
   ""\
   "EXECUTION"\
   "Commanders discretion. Stay mobile."\
   ""\
   "NOTE"\
   "You have one supply truck that carries 600 supply. The other two trucks are for transport, and the GT is for fighting or escort. Do not use any other vehicle for supply moving."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69FD66EAB8B11580}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Break through BLUFOR lines and begin extracting supplies back to our supply drop off. Do not lose 75% or more of your forces."\
   ""\
   "INTENT"\
   "Utilize your mechanized advantage to break through a specific area of the enemy front line and begin stealing supplies"\
   ""\
   "EXECUTION"\
   "Commanders discretion"\
   ""\
   ""\
   "NOTE"\
   "You have two supply trucks. Each carries 1500 supply. Do not use any other vehicle to transport supplies."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69FD66EAB8B11405}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{69FD66EAB8B11771}" {
   m_sTitle "Administration"
   m_sTextData "Attrition is active"\
   "75% OPF casualties = loss"\
   "90% BLU casualties = loss"\
   ""\
   "6000 total supply. Whichever side extracts the most supply wins"
