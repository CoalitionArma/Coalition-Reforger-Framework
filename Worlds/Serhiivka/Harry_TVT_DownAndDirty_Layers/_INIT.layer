  CRF_MissionDescriptor "{69EB45EE341D0407}" {
   m_sTitle "Mission: Situation"
   m_sTextData "German forces try to return a downed pilot while a PMC hunts for them. "\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: 60mm mortar team w/ drone spotter, MAT team, "\
   "integrated demo, ammo truck"\
   ""\
   "OPFOR Composition: Moto Inf"\
   "OPFOR Assets: High caliber rifles, MATV, platoon CE"\
   ""\
   "Time: 45 min"\
   "Weather: Dawn clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{69EB45EE341CF2AF}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Escort the VIP to the marked extraction location. "\
   ""\
   "INTENT"\
   "It's highly unlikely you will be able to get through the town without a fight. Plan for how you will fight their much more mobile force."\
   ""\
   "EXECUTION"\
   "Find the enemy with the smallest force possible, and then don't get l-shaped by their more mobile forces."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{69EB45EE341CF0E3}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Capture the VIP alive, and keep him from being extracted for the rest of the mission. "\
   ""\
   "INTENT"\
   "The assigned AO is wider than the frontage you can completely cover. You have to figure out how you're going to overcome that."\
   ""\
   "EXECUTION"\
   "The worst case scenario is the enemy bypassing your forces completely. The second worst case is isolated engagements where the full enemy platoon kills a fireteam at a time."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{69EB45EE341CF7EA}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{69EB45EE341CF6FC}" {
