 m_aMissionDescriptors {
  COA_MissionDescriptor "{6A9B4E7B7121D867}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Vietnam 1968. An unknown jungle. The communications lines that keep us connected with the airfield, and our air support, has stopped functioning. Unfortunately, we're not sure which one of the four communication posts is busted. We expect VC have something to do with it, so perform a patrol to each and ensure we get back to the firebase."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6A9B4E7B7121DF31}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Perform a patrol two the four communication towers and then back home"\
   ""\
   "INTENT"\
   "Visit each communication array. Once there, the system will automatically be repaired. Once all four have been visited in order, retreat back to the firebase. "\
   ""\
   "EXECUTION"\
   "Commanders discretion, but the patrol needs to go in linear order."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9B4E7B7121DFAA}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Find the enemy patrol and ambush them"\
   ""\
   "INTENT"\
   "Spread up however you see fit to attempt to identify the Americans patrol route. If done, communicate and ambush the americans. Do not get stuck in a single fight. Hit and run."\
   ""\
   "EXECUTION"\
   "Execute hit and run tactics to wear the americans out in the jungle"
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9B4E7B7121DE1A}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A9B4E7B7121DEB7}" {
   m_sTitle "Administration"
   m_sTextData "Mission maker/admin may choose to do respawns depending on mission flow"
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
