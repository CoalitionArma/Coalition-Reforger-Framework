 m_aMissionDescriptors {
  COA_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "US Marines have captured a damaged T14 with no main cannon ammo and are trying to take it to 1 of 2 extracts, Docks or Airfield. Russian forces are tasked with preventing that but equipped with limited means. "\
   ""\
   "BLUFOR Composition: Us Marine Infantry Company"\
   "BLUFOR Assets: Recon Drone, T14, Logistics Trucks, Squad Integrated Marksman"\
   ""\
   "OPFOR Composition: Russian Insurgent Infantry Platoon"\
   "OPFOR Assets: Recon Drone, 2 Truck Mounted SPGs"\
   ""
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "Mission is simple. Get the T14 to the Airfield or Docks and get it home to research the super advanced Russian tech. If the T14 is lost, for godsake don't let them steal our plane!"\
   ""\
   "Intel suggests the main Russian force is scattered and broken and the remaining enemy will be insurgent like and not well armed. Careful for the marked minefield. "
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "High Command says US Marines have stolen a T14 and is being escorted out of the area by said Marine company. Destroy the T14 to deny it to the enemy. They will try to use the Docks or the Airfield. Be advised of minefield marked on map. "\
   ""
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "If INDFOR is playable, add mission objectives in bullet point list. Add details for each if you feel necessary, but keep it concise."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Total Blufor wins if T14 reaches the plane or boat with Blufor control over local area."\
   ""\
   "Total Opfor wins if the T14 is destroyed AND remaining Opfor gets to the plane to extract."\
   ""\
   "If T14 is destroyed Blufor may try to stop Opfor from reaching the plane to extract"
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 1
  }
 }
