   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Total Blufor wins if T14 reaches the plane with Blufor control on local area."\
   ""\
