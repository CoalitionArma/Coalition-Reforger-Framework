 m_aMissionDescriptors {
  COA_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "After a hard fought battle in San Francisco, Russian forces attempt to salvage supplies and manpower. All the while U.S. citizens take up arms and begin resisting."\
   ""\
   "BLUFOR Composition: Light Infantry"\
   "BLUFOR Assets: Black Market"\
   ""\
   "OPFOR Composition: Mechanized Infantry"\
   "OPFOR Assets: 1xBTR-70, 1xBTR-90"\
   ""\
   "Time: Sunset"\
   ""\
   "Weather: Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "Destroy as many Russian resources before sunset."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "Consolidate your forces and resources by the bridge."\
   "Defend the bridge until sunset."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "If INDFOR is playable, add mission objectives in bullet point list. Add details for each if you feel necessary, but keep it concise."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "There's something wonkey happening with supply transfers via the inventory screen. Sometimes it requires you to click and drag supplies two times in a row."\
   ""\
   "Respawn at half time with a possibility of a 10 second delay due to how the script checks for conditions."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{694978D479B93224}" {
   m_sTitle "INTEL"
   m_sTextData "It took a lot of convincing but, old \"Difficult\" Pete has agreed to let us access his weapons cache in exchange for not asking questions, and supply units."\
   "There is an abandoned US Truck full of supplies North of here. It is marked on the map."\
   "Friendly Observers have reported locations for two BTRs and what appears to be the local HQ. They are marked on the map as well."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{694978D479B93334}" {
   m_sTitle "INTEL"
   m_sTextData "There's a tunnel under HQ that can hold most of the vehicles."\
   "The local population is armed, but whether that will hinder our operations here is yet to be seen. We should regroup before any resistance groups take advantage of the situation."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{695B7086D322F89E}" {
   m_sTitle "Commander's Notes"
   m_sTextData "The Assault on the city has gone a little too well. We have overextended our troops and resources. We'll need to rally back together to keep our cohesion."\
   "Another mechanized unit is planned to reinforce us and is moving here from the North. They're expected to be in the area shortly after sunset. If we still have enough fuel and supplies they'll cross the bridge, otherwise we'll have to abandon the city for another time."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
 }
