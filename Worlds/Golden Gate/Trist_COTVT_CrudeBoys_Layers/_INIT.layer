  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Disjointed US civilians have been stockpiling what little weapons they had to overtake a nearby RUS camp full of armaments and boats; to then use on a daring attempt to blindside a RUS captured oil rig and retake the bay. Just before enacting their plan, a US UH1H is shot down and RUS forces on alert, and now they must decide on how to proceed forward."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTitle "BLUFOR Objectives"
   m_sTextData "- Link with disjointed resistance cells & Coordinate a plan for all objectives."\
   "- React with & preserve your forces accordingly."\
   "- Overtake the Russian controlled oil rig to blindside their coastal offense."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTitle "OPFOR Objectives"
   m_sTextData "Stay grouped together and on the designated objectives. Do not kill prisoners (a fenced off area in the Encampment is the BLUFOR spawn point, waiting to be rescued as a form of respawns.)"
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "INDFOR Objectives"
   m_sTextData "If INDFOR is playable, add mission objectives in bullet point list. Add details for each if you feel necessary, but keep it concise."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTitle "Administration"
   m_sTextData "Place any meta or technical information that players should know here. Otherwise, leave empty."
   m_aFactionKeys +{
   }
   m_bShowForAnyFaction 0
  }
  CRF_MissionDescriptor "{69585029E0BAA4BC}" {
   m_sTitle "RESPAWNS!"
   m_sTextData "BLUFOR: Upon death you may remain in spectator, or switch right to UNARMED slots. These are your form of respawns, you do not get more before or after. Be careful as AI will shoot you."\
   ""\
   "OPFOR: You will be respawned as appropriate."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
 }
