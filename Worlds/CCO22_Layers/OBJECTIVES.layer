  "		if (!Replication.IsServer())"\
  "			ClientChecks();"\
  "		else"\
  "			ServerChecks();"\
  "	"
 }
 mortarAmmoSpawn {
  coords 855.903 4.504 2859.679
  userScript "	int m_CurrentQuery = 0;"\
  "	bool m_bSafeStartInit = false;"\
  "	IEntity m_MortarCrate;"\
  "	"\
  "	void SpawnMortarRounds()"\
  "	{"\
  "		if (m_CurrentQuery < 3600)"\
  "		{"\
  "			m_CurrentQuery += 10;"\
  "			return;"\
  "		}"\
  "		else"\
  "			m_CurrentQuery = 0;"\
  "		"\
  "		if (!m_MortarCrate)"\
  "			m_MortarCrate = GetGame().GetWorld().FindEntityByName(\"mortar\");"\
  "		"\
  "		if (!m_MortarCrate)"\
  "			return;"\
  "		"\
  "		SCR_InventoryStorageManagerComponent storageComp = SCR_InventoryStorageManagerComponent.Cast(m_MortarCrate.FindComponent(SCR_InventoryStorageManagerComponent));"\
  "		if (!storageComp)"\
  "			return;"\
  "		"\
  "		"\
  "		for(int i = 0; i < 80; i++)"\
  "		{"\
  "			storageComp.TrySpawnPrefabToStorage(\"{38BAE094333E31BF}Prefabs/Weapons/Ammo/Ammo_Shell_81mm_HE_M821.et\");"\
  "		}"\
  "		"\
  "		for(int i = 0; i < 40; i++)"\
  "		{"\
  "			storageComp.TrySpawnPrefabToStorage(\"{DD2065AE34D8DFA9}Prefabs/Weapons/Ammo/Ammo_Shell_81mm_Illum_M853A1.et\");"\
  "		}"\
  "		"\
  "		for(int i = 0; i < 40; i++)"\
  "		{"\
  "			storageComp.TrySpawnPrefabToStorage(\"{F7807293E94D3C88}Prefabs/Weapons/Ammo/Ammo_Shell_81mm_Smoke_M819.et\");"\
  "		}"\
  "		"\
  "	}"
  TriggerShapeType Sphere
  PeriodicQueries 1
  UpdatePeriod 10
  OnQueryFinished ""\
  "		if (!Replication.IsServer())"\
  "		{"\
  "			delete this;"\
  "			return;"\
  "		}"\
  "		"\
  "		if (!m_MortarCrate)"\
  "			m_MortarCrate = GetGame().GetWorld().FindEntityByName(\"mortar\");"\
  "			"\
  "		if (!m_bSafeStartInit)"\
  "        {"\
  "            m_bSafeStartInit = CRF_SafestartManager"\
  "                .GetInstance()"\
  "                .GetSafestartStatus();"\
  "        "\
  "            return;"\
  "        }"\
  "        "\
  "		if (!CRF_SafestartManager.GetInstance().GetSafestartStatus())"\
  "			SpawnMortarRounds();"\
  "	"
 }
}
