BaseGameTriggerEntity paradrop {
 coords 596.792 15.926 901.643
 userScript "	bool m_bSafeStartInit = false;"\
 "	ref RandomGenerator m_Random;"\
 "	void InitPlane()"\
 "	{"\
 "		vector dzStart = \"700 600 5600\";"\
 "        vector dzEnd = \"700 600 2300\";"\
 "        vector dzGreenLight = \"1700 0 0\";"\
 "        float dzAngle = 270;"\
 "    "\
 "       "\
 "    "\
 "        SCR_GroupsManagerComponent groupsMan = SCR_GroupsManagerComponent.GetInstance();"\
 "        array<SCR_AIGroup> groups = {};"\
 "        groupsMan.GetAllPlayableGroups(groups);"\
 "    "\
 "        PlayerManager pm = GetGame().GetPlayerManager();"\
 "       "\
 "    	int index = -1;"\
 "		int layer = 0;"\
 "        foreach (SCR_AIGroup group : groups)"\
 "        {"\
 "			"\
 "			 array<int> players = {};"\
 "            if (!group.GetFaction())"\
 "                continue;"\
 "    "\
 "            if (group.GetFaction().GetFactionKey() != \"BLUFOR\")"\
 "                continue;"\
 "    "\
 "            array<AIAgent> agents = {};"\
 "            group.GetAgents(agents);"\
 "    "\
 "            if (agents.Count() == 0)"\
 "                continue;"\
 "    "\
 "            foreach (AIAgent agent : agents)"\
 "            {"\
 "                int playerId = pm.GetPlayerIdFromControlledEntity(agent.GetControlledEntity());"\
 "                if (playerId <= 0)"\
 "                    continue;"\
 "    "\
 "                players.Insert(playerId);"\
 "            }"\
 "			"\
 "			index++;"\
 "			if (index > 2)"\
 "			{"\
 "				layer++;"\
 "				index = 0;"\
 "			}"\
 "				"\
 "			vector flightData[4];"\
 "        	flightData[0] = dzStart;       // Start point"\
 "       		flightData[2] = dzGreenLight;  // Green light point"\
 "        	flightData[3] = dzEnd;         // End point"\
 "			"\
 "			flightData[3][0] = flightData[3][0] +  400 * index;"\
 "			flightData[0][0] = flightData[0][0] +  400 * index;"\
 "			flightData[3][2] = flightData[3][2] +  400 * layer;"\
 "			flightData[0][2] = flightData[0][2] +  400 * layer;"\
 "			"\
 "			ref CRF_AirdropObject flight = new CRF_AirdropObject("\
 "	            \"BLUFOR\","\
 "	            \"{252AA925952F6888}Prefabs/Vehicles/C47_Drop.et\","\
 "	            flightData,"\
 "	            dzAngle,"\
 "	            players,"\
 "	            true"\
 "	        );"\
 "			 CRF_AirdropManager.GetInstance().InitFlight(flight);"\
 "        }"\
 "  "\
 "        delete this;"\
 "	}"
 TriggerShapeType Sphere
 PeriodicQueries 1
 UpdatePeriod 25
 OnQueryFinished ""\
 "		if (!Replication.IsServer())"\
 "        {"\
 "            delete this;"\
 "            return;"\
 "        }"\
 "		"\
 "		if (!m_Random)"\
 "		{"\
 "			m_Random = new RandomGenerator();"\
 "			m_Random.SetSeed(System.GetUnixTime());"\
 "		}"\
 "		"\
 "        "\
 "        if (!m_bSafeStartInit)"\
 "        {"\
 "            m_bSafeStartInit = CRF_SafestartManager"\
 "                .GetInstance()"\
 "                .GetSafestartStatus();"\
 "        "\
 "            return;"\
 "        }"\
 "        "\
 "		if (!CRF_SafestartManager.GetInstance().GetSafestartStatus())"\
 "            InitPlane();"\
 "	"
}
CRF_StaticSpawnPoint : "{0B3312C6940005B9}PrefabsMissionMaking/Systems/SpawnPoints/OPFOR_Spawn.et" {
 coords 686.836 12.177 722.171
}
