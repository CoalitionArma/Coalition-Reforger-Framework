 m_aMissionDescriptors {
  COA_MissionDescriptor "{6A5D3354FED81BD1}" {
   m_sTitle "Mission: Situation"
   m_sTextData "A Leopard2A6 is stuck on the Merturn Dam, with an incoming Russain Company, Bundeswehr forces are tasked with slowing down the Russain advance until reinforcements arrive"\
   ""\
   "BLUFOR Composition: Motorized Infantry Platoon"\
   "BLUFOR Assets: 1x Leopard2A6 and 1x MMG"\
   ""\
   "OPFOR Composition: Motorized Infantry Platoon"\
   "OPFOR Assets: 2x MAT"\
   ""\
   "Time: 12:00pm"\
   ""\
   "Weather: Cloudy"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6A5D3354FED810F7}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Defend the Leopard2A6 and its crew until time runs out."\
   ""\
   "Find and Destroy  two RUS supply caches. (A satchel can destory it) - Destorying both caches will result in a BLUFOR victory"\
   ""\
   "INTENT"\
   "The timer of this mission is much shorter than other missions, you just need to survive until time runs out. You have limited transport to send troops further up the valley. The enemy has a supply cache somewhere in Mertun with AT in it, destory it and limit enemy AT."\
   ""\
   "EXECUTION"\
   "Commanders discretion"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A5D3354FED8111A}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Destroy the Leopard2A6 and its crew before time runs out."\
   ""\
   "Defend your Supply Caches as they contain the ammo to destory the tank. If  the caches are lost it will be a BLUFOR Victory"\
   ""\
   "INTENT"\
   "You need to be quick, the mission timer is much shorter than ususal. So be fast and aggressive. You have a supply cache filled with MAT ammo with Mertun."\
   ""\
   "EXECUTION"\
   "Commanders discretion."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A5D3354FED811E5}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A5D3354FED81261}" {
