  COA_MissionDescriptor "{6A8F5380CD1A0CE2}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Move the command truck along the road, and past the marked town. Making it to the electrical substation after will consittute making it through. "\
   ""\
   "INTENT"\
   "Your team tries to move the command vehicle along roads, and through at least 1 enemy barricade. "\
   ""\
   "EXECUTION"\
   "There are a couple of significant chokepoints that should be dealt with before worrying about the objective. "
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A8F5380CD1A0C3F}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "MISSION"\
   "Prevent the enemy vehicle from making it through the AO to the substation past the farm. "\
   ""\
   "INTENT"\
   "The enemy should move a command truck along the roads through this AO, and you try to stop them. "\
   ""\
   "EXECUTION"\
   "While you have very strong choke points to hold, you are outgunned and could easily be enveloped. "
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A8F5380CD1A0374}" {
