  CRF_MissionDescriptor "{69D419D7D7B22FA8}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Falklands War, 1980s. Special forces from the UK have been inserted into the Falkland Islands. In a move to secure the region, English forces are attempting to secure high ground in order to project power."\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: 2x Gun Trucks, MAT"\
   ""\
   "OPFOR Composition: Infantry"\
   "OPFOR Assets: 2x Gun Trucks, MAT"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  CRF_MissionDescriptor "{69D419D7D7B22C0A}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "MISSION"\
   "Assume control of the 'Jagged Edge' ridge line and destroy any encroaching enemy forces in the process"\
   ""\
   "INTENT"\
   "Use your heavy caliber weapons and MAT teams to set up base of fires on surrounding hills in order to allow your infantry to maneuver through the low ground."\
   ""\
   "EXECUTION"\
   "Commander discretion following intent"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
