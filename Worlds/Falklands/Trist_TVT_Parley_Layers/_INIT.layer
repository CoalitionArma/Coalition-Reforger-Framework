 m_aMissionDescriptors {
  COA_MissionDescriptor "{6A921A88618235FD}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Inexperienced upstart locals have decided to seek fortune looting an industrial port for valuables, cash, and ledgers. BLUFOR SWAT has been tasked with apprehending/neutralizing percieved threats while attempting to save any dock employees taken hostage."\
   ""\
   "VIPs: (3 AI VIPs + 2 Player VIPS (Opt.))"\
   ""\
   "BLUFOR Composition: Infantry"\
   "BLUFOR Assets: - Armored Transports/Unarmored Transports"\
   "- Supplies"\
   ""\
   "OPFOR Composition: Poor Ragtag Infantry"\
   ""\
   "Time: 0320"\
   "Weather: Clear"
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{6A921A88618206B8}" {
   m_sTitle "BLUFOR Briefing"
   m_sTextData "- BLUFOR is to prioritize the lives of hostages within reason while also attempting to prevent OPFOR from escaping North of the Island."\
   "- Negotiations possible; Supplies+Vehicles for negotations are granted for either use OR negotiation"\
   ""
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A921A8861821BA3}" {
   m_sTitle "OPFOR Briefing"
   m_sTextData "- OPFOR must acquire all intel (within the red circles) before escaping north of the island past the ESCAPE markers. (BLUFOR has a game boundary that OPFOR does not). "\
   "- Prioritize planning/escaping with most of your force."\
   ""\
   "- Use hostages wisely to stay BLUFOR advance or negotiate for supplies/weapons/land vehicles. You do NOT want to kill all hostages."\
   ""\
   "SURRENDER RULE: If you are caught alone, you must vocally and loudly attempt to surrender if retreat to friendlies is not achievable. OPFOR is to value their lives over dying for fortune."
   m_aFactionKeys {
    "OPFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A921A8861821CD1}" {
   m_sTitle "INDFOR Briefing"
   m_sTextData "MISSION"\
   "Insert the bulleted or short-form list of objectives here"\
   ""\
   "INTENT"\
   "Insert your intent as the mission maker for this side. This should be what you expect them to do."\
   ""\
   "EXECUTION"\
   "Explain how you think the execution should unfold. Leave it as \"commanders discretion\" if you want them to plan it."
   m_aFactionKeys {
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A921A886182116F}" {
   m_sTitle "Administration"
   m_sTextData "OPFOR is not constricted by any game border, BLUFOR is. "
   m_aFactionKeys {
    "BLUFOR"
    "OPFOR"
    "INDFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A921A886183EA2D}" {
   m_sTitle "!IMPORTANT!:"
   m_sTextData "OPFOR is meant to not die recklessly nor needlessly kill innocents."\
   "BLUFOR is meant to value lives of hostages/surrendered OPFOR."\
   "The NORTHERN part of the island is inaccessible to BLUFOR, but is to OPFOR, and counts as escaping."\
   ""\
   "Both sides hold means that deter the other. Mental games encouraged."\
   "TOTAL DRAW: All hostages dead."\
   "TOTAL VICTORY: Side(s) Eliminated/Surrendered/Escaped"\
   "Anything else results in a draw."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{6A921A8A56F76CC6}" {
   m_sTitle "HOSTAGE Briefing"
   m_sTextData "Hide ONLY in buildings until found. Be entertaining and listen to the guys with guns. :^)"
   m_aFactionKeys {
    "CIV"
   }
   m_bShowForAnyFaction 0
  }
 }
