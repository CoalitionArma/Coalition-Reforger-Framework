 m_aMissionDescriptors {
  COA_MissionDescriptor "{5F3B91C20000003C}" {
   m_sTitle "Mission: Situation"
   m_sTextData "Everon, half past seven on a clear morning, with the sun still low through the trees."\
   ""\
   "No asphalt on this one. The stage leaves the main road and stays on the island's narrow dirt roads for 7.0 km, climbing into the hills, through a run of switchbacks and back down to the low ground in the east."
   m_aFactionKeys {
   }
   m_bShowForAnyFaction 1
  }
  COA_MissionDescriptor "{5F3B91C20000003D}" {
   m_sTitle "Crew Briefing"
   m_sTextData "MISSION"\
   "Set the fastest stage time, start to finish."\
   ""\
   "EXECUTION"\
   "Crews of two: a driver and a co-driver. You spawn in your crew's car on the paved road by the start, driver at the wheel. The car is held where it stands: crews are called up in slot order, move up to the line when told, and leave one at a time, 30 seconds apart (15 with more than 20 players)."\
   ""\
   "DRIVER: you won't get the pace notes on screen. Your co-driver calls them, so listen to them and keep your eyes on the road. The full roadbook is in the next briefing tab."\
   ""\
   "CO-DRIVER: at each checkpoint a hint gives you the calls for the road ahead. Every pace note is also on your map, numbered, as an orange dot at its corner, along with the checkpoints. Read the next corners out early."\
   ""\
   "The dirt is narrow and side roads are blocked with tyre stacks. Every checkpoint has to be crossed in order. Jumping your start costs 10 seconds."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{5F3B91C20000003E}" {
   m_sTitle "Roadbook"
   m_sTextData "Everon Back Roads - 7.03 km, point to point, all dirt back roads."\
   ""\
   "Grades: 1 is the tightest corner, 6 the fastest. Square: a 90 degree junction. Distances in metres to the next call; into and and mean it follows straight on."\
   ""\
   "0.17 km   Right 2 tightens, into hairpin left, 150"\
   "0.39 km   Right 3, into left 5, 250"\
   "0.76 km   Steep downhill, 900"\
   "1.66 km   Right 5 opens, 60"\
   "1.78 km   Right 3, into left 2, and right 3, 60"\
   "2.00 km   Left 5 opens, 150"\
   "2.21 km   Steep uphill, and left 4, into right 2 opens"\
   "2.36 km   Left 2 opens, 50"\
   "2.47 km   Left 4, into left 4 opens, into right 3"\
   "2.64 km   Left 1 opens, 100"\
   "2.78 km   Hairpin right, into left 4 long, into hairpin left"\
   "3.12 km   Right 4 tightens, and left 3 opens, 100"\
   "3.32 km   At junction right 2, 150"\
   "3.49 km   Right 2, 200"\
   "3.74 km   At junction right 4, into left 5, into hairpin right, 50"\
   "3.99 km   Left 2 tightens, 40"\
   "4.09 km   Left 4, 150"\
   "4.29 km   Left 2 tightens, 200"\
   "4.53 km   Steep uphill, 300"\
   "4.81 km   Left 3, 80"\
   "4.93 km   At junction square left, 40"\
   "5.01 km   Steep downhill, and right 4, into left 3 opens, 200"\
   "5.36 km   Left 4 opens, 200"\
   "5.60 km   Caution, left 1 opens, 50"\
   "5.69 km   Left 3, 100"\
   "5.86 km   Right 4, into left 3, and crest"\
   "6.03 km   Right 2 opens, 60"\
   "6.14 km   At junction right 1, 90"\
   "6.25 km   Left 3, and left 2, 90"\
   "6.43 km   At junction square right, 80"\
   "6.54 km   Right 1, 200"\
   "6.75 km   Steep downhill, 250"\
   "6.98 km   Caution, left 2 tightens, into flying finish"
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
  COA_MissionDescriptor "{5F3B91C20000003F}" {
   m_sTitle "Administration"
   m_sTextData "Rally stage. No respawns: a crashed crew is out."
   m_aFactionKeys {
    "BLUFOR"
   }
   m_bShowForAnyFaction 0
  }
